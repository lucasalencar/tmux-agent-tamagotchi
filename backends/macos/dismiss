#!/usr/bin/env bash
#
# The macOS backend's dismiss: take the window's banner out of Notification Center.
#
#   dismiss <group>
#
# `terminal-notifier -remove <group>` removes every delivered notification in that
# group, which is exactly one here: the core groups per window and a newer banner
# replaces the older one.
#
# Backgrounded for the same reason `notify` is — this runs from the user selecting a
# window, through a tmux hook, and a hook that takes a quarter of a second is a tmux
# that feels slow to move around in.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  # argv first, the environment as the fallback: the contract puts the group in both,
  # so that a backend which handles notify and dismiss together can read it one way.
  local group="${1-}"
  [ -n "$group" ] || group="${TAMA_GROUP:-}"

  # `-remove` with no group would be a removal of nothing; `-remove ALL` is what
  # terminal-notifier calls removing everything, and dismissing a banner must never
  # take down somebody else's.
  [ -n "$group" ] || exit 0

  tama_macos_notifier || exit 0

  "$TAMA_MACOS_NOTIFIER" -remove "$group" >/dev/null 2>&1 &
}

main "$@"

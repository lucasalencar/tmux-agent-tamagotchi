#!/usr/bin/env bash
#
# tama — the single public entry point of tmux-agent-tamagotchi.
#
# This file is the compatibility promise: agent hooks call `tama <subcommand>`
# and nothing else. Everything under libexec/ and lib/ is internal and free to
# move. Each subcommand is a file in libexec/ with the same name; the dispatcher
# routes by file name and keeps no list of them. The only names it owns are the
# ones that have to answer before the tmux check — `version` and `--help`.
#
# What a libexec/ script may assume, and nothing more:
#   * it is an executable file, run with the subcommand name already shifted off
#   * $TMUX is non-empty (the dispatcher has already made an absent tmux a no-op).
#     A subcommand that must run outside tmux — `doctor`, which has to say that
#     there is no server — needs an explicit exemption here; there is none yet.
#   * $TAMA_PLUGIN_DIR and $TAMA_BIN are exported; it must source lib/common.sh
#     itself, since it runs as its own process
#   * exit 2 is reserved for usage errors; every other failure exits 0 silently

set -o nounset

TAMA_VERSION='0.1.0-dev'

# Where we are, following symlinks: a user may well symlink this file even though
# the plugin never installs itself anywhere (ADR-0003). Must run in a subshell —
# it ends on a cd. Note that `case` inside a command substitution does not parse
# on bash 3.2, which is the /bin/bash every macOS ships, so this stays a function.
tama_resolve_plugin_dir() {
  local src="$1" link_dir target_dir
  while [ -L "$src" ]; do
    # A relative link target is relative to the directory holding the link.
    case "$src" in
      */*) link_dir="$(cd -P "${src%/*}" && pwd)" ;;
      *) link_dir="$PWD" ;;
    esac
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$link_dir/$src" ;;
    esac
  done
  case "$src" in
    */*) target_dir="${src%/*}" ;;
    *) target_dir='.' ;;
  esac
  cd -P "$target_dir/.." && pwd
}

TAMA_PLUGIN_DIR="$(tama_resolve_plugin_dir "${BASH_SOURCE[0]}")"
TAMA_BIN="$TAMA_PLUGIN_DIR/bin/tama"
export TAMA_PLUGIN_DIR TAMA_BIN

# A failed `.` does not stop a script, and continuing would leave the failure
# policy itself undefined — no die_usage, no require_tmux.
if [ ! -r "$TAMA_PLUGIN_DIR/lib/common.sh" ]; then
  printf 'tama: no lib/ under %s; this plugin directory is incomplete\n' \
    "$TAMA_PLUGIN_DIR" >&2
  exit 1
fi
# shellcheck source=lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

usage() {
  cat <<EOF
tama — tmux-agent-tamagotchi

Shows what the AI agents running in your tmux panes are doing: an icon per agent
pane in the window name, a flag on windows that want your attention, and a
desktop notification that clicks back to the pane that spoke. Agents report
their own lifecycle by calling this command from their hook system; the plugin
never talks to an agent.

Usage: tama <subcommand> [args]

Subcommands:
  state <state> [name]  Report what the agent in this pane is doing, as one of
                        running, waiting, idle, error, or clear to leave no
                        trace. The optional name is the agent's, remembered
                        until the next one is given.
  state subagent-start <id> / subagent-stop <id>
                        Track a delegated run by an opaque id of your choosing.
                        An agent that is idle with one still live shows as
                        working in the background rather than as finished.
  icons <window_id>     Print one glyph per agent pane of that window, in pane
                        order. This is what @tama_icons runs for you.
  flag [target]         Mark a window as wanting your attention, unless you are
                        already looking at it. Reported states do this for you:
                        waiting and error both raise it.
  unflag [target]       Take the mark off. Nothing an agent does clears a flag —
                        it records that something happened while you were away,
                        so only you clear it, by selecting the window.
  on-select             What the after-select-window hook runs: you arrived at a
                        window, so its flag goes.
  version               Print the plugin version.
  --help, -h, help      Print this message.

Put the icons in your status line wherever you want them — the plugin never
rewrites it for you. Set both formats, or the window you are looking at is the
one without icons; keep tmux's own window_flags to keep its zoom and bell
markers, but without the space it pads with, since the icons bring their own:

  set -g window-status-format '#I:#W#{?window_flags,#{window_flags},}#{E:@tama_icons}#{E:@tama_flag}'
  set -g window-status-current-format '#I:#W#{?window_flags,#{window_flags},}#{E:@tama_icons}#{E:@tama_flag}'

@tama_flag draws @tama_flag_text — " *" unless you set it — on the windows that
want you. Set it to something with #[fg=red] in it if you would rather see colour.

Common options:
  --pane <pane_id>      Act on this pane instead of \$TMUX_PANE (on the
                        subcommands that act on a pane).

Behaviour agent hooks rely on:
  * Outside tmux (no \$TMUX) every command is a silent no-op, exit 0, so one
    hook configuration works in both contexts.
  * A usage error exits 2 with a message on stderr, so a wrong hook fails
    loudly while you are editing it.
  * Anything else that goes wrong — no such pane, missing notifier, a banner
    that would not appear — exits 0 silently and never fails an agent's turn.
  * No subcommand reads stdin. All input is arguments; jq is not a dependency.

Nothing is installed onto \$PATH. Hooks find this file by asking tmux, which is
also how they keep working if you move the plugin, and how they stay quiet on a
machine where the plugin is not installed:

  [ -n "\$TMUX" ] || exit 0
  tama="\$(tmux show -gqv @tama_bin)"
  [ -n "\$tama" ] || exit 0
  "\$tama" version

Plugin directory: $TAMA_PLUGIN_DIR
EOF
}

main() {
  [ "$#" -gt 0 ] || die_usage 'no subcommand given'

  local subcommand="$1"
  shift

  case "$subcommand" in
    version | --version)
      [ "$#" -eq 0 ] || die_usage "$subcommand takes no arguments"
      printf 'tama %s\n' "$TAMA_VERSION"
      return 0
      ;;
    --help | -h | help)
      [ "$#" -eq 0 ] || die_usage "$subcommand takes no arguments"
      usage
      return 0
      ;;
    -*)
      die_usage "unknown option: $subcommand"
      ;;
    # A subcommand is a plain file name: never a path, a dotfile, or nothing.
    '' | */* | .*)
      die_usage "unknown subcommand: $subcommand"
      ;;
  esac

  # -x alone is true for a directory, and dispatching to one exits 126 with a
  # bash diagnostic instead of the usage error the contract promises.
  local command_file="$TAMA_PLUGIN_DIR/libexec/$subcommand"
  if [ ! -f "$command_file" ] || [ ! -x "$command_file" ]; then
    die_usage "unknown subcommand: $subcommand"
  fi

  # From here on the command acts on tmux, so an absent server is a no-op.
  require_tmux

  exec "$command_file" "$@"
}

main "$@"

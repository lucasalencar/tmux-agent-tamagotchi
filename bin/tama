#!/usr/bin/env bash
#
# tama — the single public entry point of tmux-agent-tamagotchi.
#
# This file is the compatibility promise: agent hooks call `tama <subcommand>`
# and nothing else. Everything under libexec/ and lib/ is internal and free to
# move. Each subcommand is a file in libexec/ with the same name; the dispatcher
# routes by file name and keeps no list of them. The only names it owns are the
# ones that have to answer before the tmux check — `version` and `--help`.
#
# What a libexec/ script may assume, and nothing more:
#   * it is an executable file, run with the subcommand name already shifted off
#   * $TMUX is non-empty (the dispatcher has already made an absent tmux a no-op),
#     unless it is one of the subcommands exempted in main() — `focus-window`, which
#     runs from a notification click where there is no $TMUX to have, and `doctor`,
#     which has to be able to say that there is no server, and `setup`, which
#     configures integrations without needing a running tmux server
#   * $TAMA_PLUGIN_DIR and $TAMA_BIN are exported; it must source lib/common.sh
#     itself, since it runs as its own process
#   * exit 2 is reserved for usage errors; every other failure exits 0 silently —
#     with one deliberate exception, `doctor`, which nothing runs from a hook and
#     which exits non-zero precisely so it can be used as a check

set -o nounset

TAMA_VERSION='0.1.0'

# Where we are, following symlinks: a user may well symlink this file even though
# the plugin never installs itself anywhere (ADR-0003). Must run in a subshell —
# it ends on a cd. Note that `case` inside a command substitution does not parse
# on bash 3.2, which is the /bin/bash every macOS ships, so this stays a function.
tama_resolve_plugin_dir() {
  local src="$1" link_dir target_dir
  while [ -L "$src" ]; do
    # A relative link target is relative to the directory holding the link.
    case "$src" in
      */*) link_dir="$(cd -P "${src%/*}" && pwd)" ;;
      *) link_dir="$PWD" ;;
    esac
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$link_dir/$src" ;;
    esac
  done
  case "$src" in
    */*) target_dir="${src%/*}" ;;
    *) target_dir='.' ;;
  esac
  cd -P "$target_dir/.." && pwd
}

TAMA_PLUGIN_DIR="$(tama_resolve_plugin_dir "${BASH_SOURCE[0]}")"
TAMA_BIN="$TAMA_PLUGIN_DIR/bin/tama"
export TAMA_PLUGIN_DIR TAMA_BIN

# A failed `.` does not stop a script, and continuing would leave the failure
# policy itself undefined — no die_usage, no require_tmux.
if [ ! -r "$TAMA_PLUGIN_DIR/lib/common.sh" ]; then
  printf 'tama: no lib/ under %s; this plugin directory is incomplete\n' \
    "$TAMA_PLUGIN_DIR" >&2
  exit 1
fi
# shellcheck source=lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

usage() {
  cat <<EOF
tama — tmux-agent-tamagotchi

Usage: tama <subcommand> [args]

Commands:
  state <state> [name]  Set pane state: running, waiting, idle, error, or clear.
  state subagent-start <id> / subagent-stop <id>
                        Track a delegated run by opaque id.
  icons <window_id>     Print pane-state icons in pane order.
  flag [target]         Mark a window. No-op for the current window.
  unflag [target]       Clear a window mark.
  notify <agent> <msg>  Mark the window and send a desktop notification.
  dismiss [target]      Dismiss a window notification.
  focus-window <sess>   Focus the terminal showing a tmux session.
  list [--session <s>]  List agent panes as stable, headerless TSV.
  summary <session_id>  Count agent panes using that session's summary scope.
  summary-scope --session <session_id> current|all|toggle
                        Select the summary scope for one explicit session.
  gc [--all]            Clear stale pane state. Default: current window.
  on-select [--all]     Clear mark, dismiss notification, and run gc.
  doctor                Print installation diagnostics. Exit 1 on failure.
  hook <agent> <event>  Dispatch to integrations/<agent>/hook.
  setup <integration>   Configure an integration that provides a setup helper.
  version               Print the plugin version.
  --help, -h, help      Print help.

Common option:
  --pane <pane_id>      Target pane. Default: \$TMUX_PANE.

Status line:

  set -g window-status-format '#I:#W#{?window_flags,#{window_flags},}#{E:@tama_icons}#{E:@tama_flag}'
  set -g window-status-current-format '#I:#W#{?window_flags,#{window_flags},}#{E:@tama_icons}#{E:@tama_flag}'

Status summary:

  Compose '#{E:@tama_status_summary}' into status-left where you want it.
  @tama_summary_scope is a session option: current (default) or all.
  bind-key G run-shell '#{q:@tama_bin} summary-scope --session #{q:session_id} toggle'

Configuration (defaults shown):

  set -g @tama_icon_set glyphs     # or 'pets' (emoji) or 'ascii'
  set -g @tama_icon_running '●'
  set -g @tama_icon_waiting '◐'
  set -g @tama_icon_background '⚙'
  set -g @tama_icon_idle '○'
  set -g @tama_icon_error '✕'
  set -g @tama_icon_unknown '?'
  set -g @tama_show_idle on
  set -g @tama_show_background on
  set -g @tama_icon_prefix ' '
  set -g @tama_icon_separator ''
  set -g @tama_icon_suffix ''
  set -g @tama_summary_show_running always
  set -g @tama_summary_show_waiting always
  set -g @tama_summary_show_idle always
  set -g @tama_summary_show_background nonzero
  set -g @tama_summary_show_error nonzero
  set -g @tama_summary_show_unknown nonzero
  set -g @tama_summary_prefix ''
  set -g @tama_summary_separator ' '
  set -g @tama_summary_suffix ''
  set -g @tama_notifications on
  set -g @tama_backend auto        # auto, macos, libnotify, none, or absolute path
  set -g @tama_title_format '$TAMA_NOTIFY_TITLE_DEFAULT'
  set -g @tama_group_format '$TAMA_NOTIFY_GROUP_DEFAULT'
  set -g @tama_label_command ''
  set -g @tama_suppress_when_focused on
  set -g @tama_notify_command ''
  set -g @tama_dismiss_command ''
  set -g @tama_focused_command ''
  set -g @tama_focus_command ''
  set -g @tama_terminal_app ''
  set -g @tama_terminal_bundle_id ''
  set -g @tama_terminal_notifier ''
  set -g @tama_notify_send ''
  set -g @tama_gc_shells 'sh bash zsh fish dash ksh mksh ash csh tcsh'
  set -g @tama_manage_hooks off

Boolean values: 'off', 'no', '0', and 'false' turn it off. Other values enable it.
An empty string is a configured value. Options are read on each invocation/redraw.

macOS session-title setup:

  set -g set-titles on
  set -g set-titles-string '#S'

Runtime contract:
  - No \$TMUX: commands exit 0 without output.
  - Usage error: exit 2; diagnostic on stderr.
  - Operational error: exit 0 without output.
  - doctor: exit 1 when checks fail; works outside tmux.
  - setup: reports configuration failures; works outside tmux.
  - focus-window: works outside tmux.
  - No command reads stdin. jq is not required.
  - Focus suppression requires confirmation from tmux and the backend.
  - gc clears state only after the pane returns to @tama_gc_shells.
  - Global focus sweeping requires: set -g focus-events on

Hook-safe executable lookup:

  [ -n "\$TMUX" ] || exit 0
  tama="\$(tmux show -gqv @tama_bin)"
  [ -n "\$tama" ] || exit 0
  "\$tama" version

Plugin directory: $TAMA_PLUGIN_DIR
EOF
}

main() {
  [ "$#" -gt 0 ] || die_usage 'no subcommand given'

  local subcommand="$1"
  shift

  case "$subcommand" in
    version | --version)
      [ "$#" -eq 0 ] || die_usage "$subcommand takes no arguments"
      printf 'tama %s\n' "$TAMA_VERSION"
      return 0
      ;;
    --help | -h | help)
      [ "$#" -eq 0 ] || die_usage "$subcommand takes no arguments"
      usage
      return 0
      ;;
    -*)
      die_usage "unknown option: $subcommand"
      ;;
    # A subcommand is a plain file name: never a path, a dotfile, or nothing.
    '' | */* | .*)
      die_usage "unknown subcommand: $subcommand"
      ;;
  esac

  # -x alone is true for a directory, and dispatching to one exits 126 with a
  # bash diagnostic instead of the usage error the contract promises.
  local command_file="$TAMA_PLUGIN_DIR/libexec/$subcommand"
  if [ ! -f "$command_file" ] || [ ! -x "$command_file" ]; then
    die_usage "unknown subcommand: $subcommand"
  fi

  # From here on the command acts on tmux, so an absent server is a no-op — with two
  # exemptions, which are the promise made in the header above.
  #
  # `focus-window` is the last step of a notification's click action, and a click
  # arrives in a process the desktop started: no $TMUX anywhere in its environment.
  # Making it a no-op there would make every click do nothing at all, silently, on the
  # one path a user judges the whole feature by. It needs no tmux server of its own —
  # it hands a session name to the backend and nothing else.
  #
  # `doctor` is the other, for the opposite reason: "there is no tmux server here" is
  # one of the answers it exists to give, and a user whose plugin never loaded has no
  # server to run it from. A doctor that goes quiet outside tmux is silent exactly when
  # it is needed.
  case "$subcommand" in
    focus-window | doctor | setup) ;;
    *) require_tmux ;;
  esac

  exec "$command_file" "$@"
}

main "$@"

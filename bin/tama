#!/usr/bin/env bash
#
# tama — the single public entry point of tmux-agent-tamagotchi.
#
# This file is the compatibility promise: agent hooks call `tama <subcommand>`
# and nothing else. Everything under libexec/ and lib/ is internal and free to
# move. Each subcommand is a file in libexec/ with the same name; the dispatcher
# routes by file name and keeps no list of them. The only names it owns are the
# ones that have to answer before the tmux check — `version` and `--help`.
#
# What a libexec/ script may assume, and nothing more:
#   * it is an executable file, run with the subcommand name already shifted off
#   * $TMUX is non-empty (the dispatcher has already made an absent tmux a no-op),
#     unless it is one of the subcommands exempted in main() — `focus-window`, which
#     runs from a notification click where there is no $TMUX to have. `doctor`, which
#     has to be able to say that there is no server, will want the same exemption.
#   * $TAMA_PLUGIN_DIR and $TAMA_BIN are exported; it must source lib/common.sh
#     itself, since it runs as its own process
#   * exit 2 is reserved for usage errors; every other failure exits 0 silently

set -o nounset

TAMA_VERSION='0.1.0-dev'

# Where we are, following symlinks: a user may well symlink this file even though
# the plugin never installs itself anywhere (ADR-0003). Must run in a subshell —
# it ends on a cd. Note that `case` inside a command substitution does not parse
# on bash 3.2, which is the /bin/bash every macOS ships, so this stays a function.
tama_resolve_plugin_dir() {
  local src="$1" link_dir target_dir
  while [ -L "$src" ]; do
    # A relative link target is relative to the directory holding the link.
    case "$src" in
      */*) link_dir="$(cd -P "${src%/*}" && pwd)" ;;
      *) link_dir="$PWD" ;;
    esac
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$link_dir/$src" ;;
    esac
  done
  case "$src" in
    */*) target_dir="${src%/*}" ;;
    *) target_dir='.' ;;
  esac
  cd -P "$target_dir/.." && pwd
}

TAMA_PLUGIN_DIR="$(tama_resolve_plugin_dir "${BASH_SOURCE[0]}")"
TAMA_BIN="$TAMA_PLUGIN_DIR/bin/tama"
export TAMA_PLUGIN_DIR TAMA_BIN

# A failed `.` does not stop a script, and continuing would leave the failure
# policy itself undefined — no die_usage, no require_tmux.
if [ ! -r "$TAMA_PLUGIN_DIR/lib/common.sh" ]; then
  printf 'tama: no lib/ under %s; this plugin directory is incomplete\n' \
    "$TAMA_PLUGIN_DIR" >&2
  exit 1
fi
# shellcheck source=lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

usage() {
  cat <<EOF
tama — tmux-agent-tamagotchi

Shows what the AI agents running in your tmux panes are doing: an icon per agent
pane in the window name, a flag on windows that want your attention, and a
desktop notification that clicks back to the pane that spoke. Agents report
their own lifecycle by calling this command from their hook system; the plugin
never talks to an agent.

Usage: tama <subcommand> [args]

Subcommands:
  state <state> [name]  Report what the agent in this pane is doing, as one of
                        running, waiting, idle, error, or clear to leave no
                        trace. The optional name is the agent's, remembered
                        until the next one is given.
  state subagent-start <id> / subagent-stop <id>
                        Track a delegated run by an opaque id of your choosing.
                        An agent that is idle with one still live shows as
                        working in the background rather than as finished.
  icons <window_id>     Print one glyph per agent pane of that window, in pane
                        order. This is what @tama_icons runs for you.
  flag [target]         Mark a window as wanting your attention, unless you are
                        already looking at it. Reported states do this for you:
                        waiting and error both raise it.
  unflag [target]       Take the mark off. Nothing an agent does clears a flag —
                        it records that something happened while you were away,
                        so only you clear it, by selecting the window.
  notify <agent> <msg>  Raise a desktop banner saying that agent needs you, unless
                        you are demonstrably already looking at its window. Marks
                        the window too, and a click on the banner selects the
                        window, then the pane, then brings the terminal forward.
  dismiss [target]      Take down the banner that window has pending. Arriving at
                        the window does this for you.
  focus-window <sess>   Bring the terminal window showing that session to the
                        front. The last step of a banner's click action, and the
                        one command here that works outside tmux, because that is
                        where a click arrives.
  gc [--all]            Clear the state of panes whose agent is gone, so a dead
                        agent stops looking busy. One window by default; --all
                        sweeps every pane on the server.
  on-select [--all]     What the after-select-window hook runs: you arrived at a
                        window, so its flag goes and its panes are swept. With
                        --all the sweep covers the whole server, which is what
                        the client-focus-in and client-attached hooks ask for.
  hook <agent> <event>  Hand an event to the adapter shipped for that agent, in
                        integrations/<agent>/hook, which is where everything
                        particular to it lives. Claude Code users wire this and
                        nothing else; see integrations/claude-code/README.md.
  version               Print the plugin version.
  --help, -h, help      Print this message.

Put the icons in your status line wherever you want them — the plugin never
rewrites it for you. Set both formats, or the window you are looking at is the
one without icons; keep tmux's own window_flags to keep its zoom and bell
markers, but without the space it pads with, since the icons bring their own:

  set -g window-status-format '#I:#W#{?window_flags,#{window_flags},}#{E:@tama_icons}#{E:@tama_flag}'
  set -g window-status-current-format '#I:#W#{?window_flags,#{window_flags},}#{E:@tama_icons}#{E:@tama_flag}'

@tama_flag draws @tama_flag_text — " *" unless you set it — on the windows that
want you. Set it to something with #[fg=red] in it if you would rather see colour.

The icons are yours. Every option below is read on every redraw, so tmux
source-file is enough to see a change; the values shown are the defaults:

  set -g @tama_icon_set glyphs     # or 'pets' (emoji) or 'ascii'
  set -g @tama_icon_running '●'    # one per state; an individual icon always
  set -g @tama_icon_waiting '◐'    # wins over the set it came from
  set -g @tama_icon_background '⚙'
  set -g @tama_icon_idle '○'
  set -g @tama_icon_error '✕'
  set -g @tama_show_idle on        # 'off' leaves idle panes without an icon
  set -g @tama_show_background on  # 'off' draws them as running instead: the
                                   # agent is working either way, you just stop
                                   # being told it is its subagents working
  set -g @tama_icon_prefix ' '     # drawn only when there is an icon to draw
  set -g @tama_icon_separator ''   # between two agent panes of one window
  set -g @tama_icon_suffix ''

An option set to the empty string is a configuration and not an absent one, so
@tama_icon_prefix '' really means no prefix. The 'pets' emoji are double width:
they cost a column each, so a status line full of windows truncates sooner, and
terminals do not all measure them the way tmux does. 'ascii' is single-column and
free of the characters a status line would have to escape.

Notifications are the same story one layer out: off with one option, and the
icons and the window mark carry on without them.

  set -g @tama_notifications on
  set -g @tama_backend auto      # a directory of up to four executables: 'auto'
                                 # picks one that works on this machine, a bare
                                 # name is one shipped here, an absolute path is
                                 # your own and needs no fork of this plugin

'auto' means 'macos' on a Mac with terminal-notifier installed and 'none' — silence,
no errors — anywhere else, so a machine with no notifier needs no configuration to be
quiet. The macOS backend recognises the terminal window showing a session by its
title, which is worth setting up, because it is what stops you being notified about a
window you are looking at:

  set -g set-titles on
  set -g set-titles-string '#S'

A banner's title is a real tmux format string, expanded against the pane that
spoke — there is no template language here to learn, and no idea of a "project":
that is a basename modifier on the pane's path, and anything else is whatever you
write. The plugin adds what only it knows as pane options for you to reach:
@tama_pane_agent, @tama_pane_cwd — where the pane was when it last reported a
state, which the default falls back on because tmux cannot always say where a
pane is now — and @tama_pane_label when you have a label provider.

  set -g @tama_title_format '#{@tama_pane_agent} - #{?pane_current_path,#{b:pane_current_path},#{b:@tama_pane_cwd}}#{?@tama_pane_label, (#{@tama_pane_label}),}'
  set -g @tama_group_format 'tmux-window-#{window_id}'
  set -g @tama_label_command ''  # your own window-naming script, given the window
                                 # id, its first line of output is the label;
                                 # empty means nothing is ever run

Banners are grouped per window, from that one format, which both raising and
dismissing read — so a newer banner replaces the older one and arriving at the
window takes it down. If your own tooling already names your windows, point
@tama_label_command at it and the banners will say what your status line says.

You are not notified about a window you are looking at, and that takes two
answers agreeing: tmux says that window is current in its own session with
somebody attached, and the backend says the terminal really is in front. Either
one saying no — including a backend that cannot tell — means the banner is
delivered, because a minimized terminal swallowing a notification is the worst
thing this plugin could do to you.

  set -g @tama_suppress_when_focused on
  set -g @tama_notify_command ''    # any one capability, replaced by your own
  set -g @tama_dismiss_command ''   # script: same arguments, same environment
  set -g @tama_focused_command ''
  set -g @tama_focus_command ''
  set -g @tama_terminal_app ''         # what a backend calls your terminal:
  set -g @tama_terminal_bundle_id ''   # the process name and the bundle id, both
                                       # Ghostty unless \$TERMINAL_APP_NAME and
                                       # \$TERMINAL_BUNDLE_ID say otherwise
  set -g @tama_terminal_notifier ''    # the macOS notifier, if PATH and the two
                                       # Homebrew prefixes are not where yours is

An agent that exits without saying so would otherwise leave its icon behind
forever, so the state is swept: a pane is stale when it is running a different
command from the one recorded when its state was written, and a pane with no
recorded command is stale when what it is running now is a shell.

  set -g @tama_gc_shells 'sh bash zsh fish dash ksh mksh ash csh tcsh'

The sweep runs on window selection and pane selection for the window you are
looking at, and over the whole server when you come back to the terminal —
either by attaching, or by your terminal regaining focus, which needs tmux's own
'set -g focus-events on' to be reported at all. Coming back also takes the mark
off the window you land on, which no selection would have done. Everything the
sweep clears is unset rather than emptied, including a subagent id a crashed
delegated run leaked, so a swept pane is indistinguishable from one that never
ran an agent.

The plugin appends its hooks with 'set-hook -ga' and never assigns them, so your
own lines on those events keep working. Load order is yours to get right,
though: a plain 'set-hook' of your own after the plugin loads replaces the whole
array, the plugin's line included, and the next reload puts it back. Put your
own assignments before the TPM line, or append them too. Mouse bindings cannot
be appended at all, which is why the plugin installs none.

  set -g @tama_manage_hooks off   # wire the hooks yourself, from your own config

An agent whose adapter ships here needs one block of hook configuration and
nothing else — a call to 'tama hook <agent> <event>' per event, with no payload
knowledge and no path to this plugin in it. Claude Code's block is in
$TAMA_PLUGIN_DIR/integrations/claude-code/README.md. Adapters are best effort and
outside the version promise, which integrations/README.md explains, along with
the recipe for driving this CLI from an agent that has no adapter yet.

Common options:
  --pane <pane_id>      Act on this pane instead of \$TMUX_PANE (on the
                        subcommands that act on a pane).

Behaviour agent hooks rely on:
  * Outside tmux (no \$TMUX) every command is a silent no-op, exit 0, so one
    hook configuration works in both contexts.
  * A usage error exits 2 with a message on stderr, so a wrong hook fails
    loudly while you are editing it.
  * Anything else that goes wrong — no such pane, missing notifier, a banner
    that would not appear — exits 0 silently and never fails an agent's turn.
  * No subcommand reads stdin. All input is arguments; jq is not a dependency.

Nothing is installed onto \$PATH. Hooks find this file by asking tmux, which is
also how they keep working if you move the plugin, and how they stay quiet on a
machine where the plugin is not installed:

  [ -n "\$TMUX" ] || exit 0
  tama="\$(tmux show -gqv @tama_bin)"
  [ -n "\$tama" ] || exit 0
  "\$tama" version

Plugin directory: $TAMA_PLUGIN_DIR
EOF
}

main() {
  [ "$#" -gt 0 ] || die_usage 'no subcommand given'

  local subcommand="$1"
  shift

  case "$subcommand" in
    version | --version)
      [ "$#" -eq 0 ] || die_usage "$subcommand takes no arguments"
      printf 'tama %s\n' "$TAMA_VERSION"
      return 0
      ;;
    --help | -h | help)
      [ "$#" -eq 0 ] || die_usage "$subcommand takes no arguments"
      usage
      return 0
      ;;
    -*)
      die_usage "unknown option: $subcommand"
      ;;
    # A subcommand is a plain file name: never a path, a dotfile, or nothing.
    '' | */* | .*)
      die_usage "unknown subcommand: $subcommand"
      ;;
  esac

  # -x alone is true for a directory, and dispatching to one exits 126 with a
  # bash diagnostic instead of the usage error the contract promises.
  local command_file="$TAMA_PLUGIN_DIR/libexec/$subcommand"
  if [ ! -f "$command_file" ] || [ ! -x "$command_file" ]; then
    die_usage "unknown subcommand: $subcommand"
  fi

  # From here on the command acts on tmux, so an absent server is a no-op — with one
  # exemption, which is the promise made in the header above.
  #
  # `focus-window` is the last step of a notification's click action, and a click
  # arrives in a process the desktop started: no $TMUX anywhere in its environment.
  # Making it a no-op there would make every click do nothing at all, silently, on the
  # one path a user judges the whole feature by. It needs no tmux server of its own —
  # it hands a session name to the backend and nothing else.
  case "$subcommand" in
    focus-window) ;;
    *) require_tmux ;;
  esac

  exec "$command_file" "$@"
}

main "$@"

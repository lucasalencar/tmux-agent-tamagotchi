#!/usr/bin/env bash
#
#   tama state <running|waiting|idle|error|clear> [agent_name] [--agent <agent_id>] [--pane <pane_id>]
#   tama state clear [--keep-agents] [--pane <pane_id>]
#   tama state subagent-start <id> [--agent <agent_id>] [--pane <pane_id>]
#   tama state subagent-stop  <id> [--agent <agent_id>] [--pane <pane_id>]
#   tama state subagent-reconcile [<id>…] [--agent <agent_id>] [--pane <pane_id>]
#   tama state agent-reconcile [<agent-id>…] [--namespace <prefix>] [--pane <pane_id>]
#
# Agent names are sticky, unknown states are ignored for forward compatibility,
# and attention states raise their flag on every event rather than only on changes.
#
# With --agent, the report addresses one entry of the pane's agent record instead
# of the pane's single legacy state: each entry keeps its own main state and its
# own subagent list, and the pane draws one icon per entry. Without --agent,
# everything behaves exactly as before, and a pane with no agent entries is
# untouched by the agent paths.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

# The optimistic loop below, in numbers: attempts in total, not retries after the
# first. Constants rather than options for now — nothing has asked to tune them,
# and the failure they guard is benign.
TAMA_SUBAGENT_ATTEMPTS=5
TAMA_SUBAGENT_RETRY_DELAY=0.05

# Record state and the command snapshot used by stale detection, writing only changes.
report() {
  local pane="$1" state_main="$2" name="$3" refresh='no'
  local state_before_derived='' state_after_derived logged_after_main outcome reason subagent_count=0
  if ! tama_pane_read "$pane"; then
    tama_log_command_result skipped
    exit 0
  fi

  if [ -n "${TAMA_LOG_FILE:-}" ]; then
    logged_after_main="$state_main"
    tama_subagents_count "$TAMA_PANE_SUBAGENTS"
    subagent_count="$TAMA_SUBAGENTS_COUNT"
  fi
  # What the pane shows is the agent-aware display, not the legacy half alone:
  # on a pane with agent entries the legacy state is shadowed, so comparing
  # legacy displays would redraw every client for an invisible change.
  state_before_derived="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"

  # Only a different icon is worth redrawing every client for; a pane whose command
  # or path merely moved is a cheap write and nothing a user can see.
  state_after_derived="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$state_main" "$TAMA_PANE_SUBAGENTS")"
  tama_pane_display_changed "$state_before_derived" "$state_after_derived" && refresh='yes'

  # The snapshot comes from tmux, not from the hook, so a value the record cannot
  # hold is nobody's mistake to be told about — but storing it would shift every
  # field after it on the next read and leave the pane unable to recognise itself.
  # A pane in a directory named like that simply has no snapshot.
  local snapshot_cmd="$TAMA_PANE_CURRENT_CMD" snapshot_cwd="$TAMA_PANE_CURRENT_PATH"
  tama_pane_value_is_storable "$snapshot_cmd" || snapshot_cmd=''
  tama_pane_value_is_storable "$snapshot_cwd" || snapshot_cwd=''

  # Staged as <new> then <stored>: the snapshot_ values are what the pane is doing
  # now, the others what it last said. Swapping the pair in the `cmd` or `cwd` line
  # would silently invert the comparison stale-state detection makes.
  tama_batch_reset
  tama_pane_stage "$TAMA_PANE_ID" state_main "$state_main" "$TAMA_PANE_STATE_MAIN"
  tama_pane_stage "$TAMA_PANE_ID" cmd "$snapshot_cmd" "$TAMA_PANE_CMD"
  tama_pane_stage "$TAMA_PANE_ID" agent "${name:-$TAMA_PANE_AGENT}" "$TAMA_PANE_AGENT"
  tama_pane_stage "$TAMA_PANE_ID" cwd "$snapshot_cwd" "$TAMA_PANE_CWD"
  # Not error handling: a flush with nothing staged says so by its status, and this
  # is the last command of the script, so without this the hot path — a repeated
  # `state running` — would exit non-zero out of an agent's hook.
  tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID" || true

  if [ -n "${TAMA_LOG_FILE:-}" ]; then
    outcome="$TAMA_BATCH_WRITE_STATUS"
    reason=''
    case "$outcome" in
      skipped) reason=pane_record_unchanged ;;
      failed)
        reason=write_pane_record_failed
        logged_after_main="$TAMA_PANE_STATE_MAIN"
        state_after_derived="$state_before_derived"
        ;;
    esac
    tama_log_state_decision report_state "$outcome" "$reason" "$TAMA_PANE_ID" \
      "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" \
      "$subagent_count" "$logged_after_main" "$state_after_derived" "$subagent_count"
  fi

  # Deliberately after the flush and outside it: the flag answers to the *event*, not
  # to the write. An agent already in `waiting` that asks again — the user glanced at
  # the window, went back to another one, and the question is still open — stages
  # nothing above, and would raise no flag if this hung off the write.
  #
  # Only the two states that mean the agent has stopped and needs the user. `running`
  # and `idle` are not an interruption, and it is the hot path besides: this costs a
  # round trip, which is exactly why it is not on it.
  case "$state_main" in
    waiting | error)
      TAMA_FLAG_WRITE_STATUS=''
      tama_flag_raise_automatic "$TAMA_PANE_ID"
      if [ -n "${TAMA_LOG_FILE:-}" ] && [ -n "$TAMA_FLAG_WRITE_STATUS" ]; then
        tama_log_effect effect.completed flag_write "e-$$-${RANDOM:-0}" \
          "$TAMA_FLAG_WRITE_STATUS" '' ''
      fi
      ;;
  esac
}

# Removes every trace of the agent from the pane. Unsetting rather than emptying
# is the whole point: a cleared pane must be indistinguishable from a pane that
# never ran an agent, and it is also what heals a subagent id that leaked.
#
# Which options those are belongs to the record itself — see TAMA_PANE_OPTIONS in
# lib/pane.sh — because the stale-state sweep takes a pane apart the same way, and
# an option only one of them knew about would survive the other. The test asks the
# pane whether anything of ours is left rather than checking a list of names, so an
# option added to the record and forgotten there fails it.
clear_pane() {
  local pane="$1" keep="${2:-no}" refresh='no' logging=no before_derived='' before_count=0 after_derived=''
  if ! tama_pane_read "$pane"; then
    tama_log_command_result skipped
    exit 0
  fi
  if [ -n "${TAMA_LOG_FILE:-}" ]; then
    logging=yes
    tama_subagents_count "$TAMA_PANE_SUBAGENTS"
    before_count="$TAMA_SUBAGENTS_COUNT"
  fi
  # Agent-aware like report(): clearing a pane whose icon comes from an entry
  # must redraw, and clearing a pane that draws nothing must not.
  before_derived="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"

  # Nothing of ours is on this pane, so there is nothing to unset — which is what
  # keeps clearing a pane that never ran an agent free of a write and of the read
  # per option that asking one at a time would cost.
  local trace="$TAMA_PANE_STATE_MAIN$TAMA_PANE_SUBAGENTS$TAMA_PANE_AGENTS$TAMA_PANE_CMD"
  trace="$trace$TAMA_PANE_AGENT$TAMA_PANE_CWD"
  if [ -z "$trace" ]; then
    [ "$logging" = no ] || tama_log_state_decision clear_state skipped \
      pane_record_unchanged "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    return 0
  fi

  # With --keep-agents the entries stay, so what remains still draws: the
  # refresh compares against the surviving display, not an empty pane.
  # Disposal uses this to take down one integration's pane presence without
  # touching entries another integration still owns.
  if [ "$keep" = yes ]; then
    after_derived="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" '' '')"
  fi
  # Clearing an agent pane takes an icon away, which is a change a user sees.
  tama_pane_display_changed "$before_derived" "$after_derived" && refresh='yes'

  tama_batch_reset
  if [ "$keep" = yes ]; then
    tama_pane_stage_clear "$TAMA_PANE_ID" agents
  else
    tama_pane_stage_clear "$TAMA_PANE_ID"
  fi
  # As in report(): nothing staged is not a failure, and this is the exit status.
  tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID" || true
  if [ "$logging" = yes ]; then
    if [ "$TAMA_BATCH_WRITE_STATUS" = applied ]; then
      tama_log_state_decision clear_state applied '' "$TAMA_PANE_ID" \
        "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$before_derived" \
        "$before_count" '' "$after_derived" 0
    else
      tama_log_state_decision clear_state failed write_pane_record_failed \
        "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
        "$before_derived" "$before_count" "$TAMA_PANE_STATE_MAIN" \
        "$before_derived" "$before_count"
    fi
  fi
}

# Adds or removes a subagent id, and recomputes the display state with it, since
# whether any subagent is live is what tells `background` from `idle`.
#
# No flag is raised here. A subagent starting or stopping is the agent talking about
# its own bookkeeping, not asking the user for anything; only `waiting` and `error`
# interrupt somebody.
#
# tmux has no atomic read-modify-write, so the list is maintained optimistically:
# read, modify, write, read back, and try again from a fresh read if the list no
# longer says what this call needed it to say. Everything an attempt decides — what
# the list should become, whether the screen changes — is decided inside the loop,
# from the read that attempt made.
#
# What "worked" means is the caller's own id, not the list: a start is done when
# its id is there and a stop when its id is gone. Comparing the whole list instead
# would read somebody else's concurrent start as a lost race, and rewriting the
# list read before it would then drop *their* id.
#
# The read-back sees only the writers that landed before it, so this is still racy
# and deliberately not locked. What the retries buy is the interleaving where the
# loser is still looking: it notices its id gone and puts it back. What they cannot
# buy is the one where both writers verify before the other lands — measured at
# 4 in 120 with three concurrent starts and 10 in 120 with four — and then an id is
# lost, which makes a pane with a live subagent look finished until the pane is
# cleared. Nothing puts it back, because the stop for an id that is not in the list
# is a no-op.
#
# Two directions are accepted for the same reason. A leaked id makes the pane look
# busier than it is and is healed by the next `state clear` or sweep; a retried
# start can resurrect an id a concurrent stop had just removed, which lands in the
# same benign direction. What must never be resurrected is a pane a `state clear`
# has taken away, because clear is what the healing story rests on — see the
# read-back. All of it is bookkeeping without a compare-and-swap: a lock
# in a shell script invoked on every subagent event would cost more, on every event,
# than a wrong glyph on a few.
subagent() {
  local target="$1" verb="$2" id="$3" attempt=1 wanted was refresh was_agent_pane
  local before_count=0 after_count=0 before_derived='' logging=no
  [ -n "${TAMA_LOG_FILE:-}" ] && logging=yes
  while :; do
    if ! tama_pane_read "$target"; then
      tama_log_command_result skipped
      exit 0
    fi
    # From here on the pane is addressed by its own id: a target given by index
    # could come to mean another pane while this loop is still running.
    target="$TAMA_PANE_ID"
    was="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
    if [ "$logging" = yes ]; then
      before_derived="$was"
      tama_subagents_count "$TAMA_PANE_SUBAGENTS"
      before_count="$TAMA_SUBAGENTS_COUNT"
    fi
    # Whether this was an agent pane at all when the attempt started, which is how
    # the read-back below tells a `state clear` from a lost race.
    was_agent_pane="$TAMA_PANE_STATE_MAIN"

    case "$verb" in
      subagent-start) tama_subagents_add "$TAMA_PANE_SUBAGENTS" "$id" ;;
      subagent-stop) tama_subagents_remove "$TAMA_PANE_SUBAGENTS" "$id" ;;
    esac
    wanted="$TAMA_SUBAGENTS_NEW"

    refresh='no'
    tama_pane_display_changed "$was" "$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$wanted")" && refresh='yes'

    tama_batch_reset
    tama_pane_stage "$target" subagents "$wanted" "$TAMA_PANE_SUBAGENTS"
    # Nothing to write: a duplicate start, or a stop for an id that is not there.
    if ! tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID"; then
      [ "$logging" = no ] || tama_log_subagent_attempt skipped \
        subagent_state_unchanged "$attempt" "$target" "$TAMA_PANE_WINDOW_ID" \
        "$was_agent_pane" "$before_derived" "$before_count" \
        "$was_agent_pane" "$before_derived" "$before_count"
      return 0
    fi

    if [ "$TAMA_BATCH_WRITE_STATUS" = failed ]; then
      [ "$logging" = no ] || tama_log_subagent_attempt failed \
        write_pane_record_failed "$attempt" "$target" "$TAMA_PANE_WINDOW_ID" \
        "$was_agent_pane" "$before_derived" "$before_count" \
        "$was_agent_pane" "$before_derived" "$before_count"
      return 0
    fi

    if ! tama_pane_read "$target"; then
      [ "$logging" = no ] || tama_log_subagent_attempt failed \
        read_pane_state_failed "$attempt" "$target" '' "$was_agent_pane" \
        "$before_derived" "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi

    if [ "$logging" = yes ]; then
      tama_subagents_count "$TAMA_PANE_SUBAGENTS"
      after_count="$TAMA_SUBAGENTS_COUNT"
    fi

    if subagent_clear_won "$target" "$was_agent_pane"; then
      if [ "$TAMA_SUBAGENT_CLEAR_STATUS" = failed ]; then
        [ "$logging" = no ] || tama_log_subagent_attempt failed \
          clear_residue_failed "$attempt" "$target" "$TAMA_PANE_WINDOW_ID" \
          "$was_agent_pane" "$before_derived" "$before_count" \
          "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_DISPLAY" "$after_count"
      else
        [ "$logging" = no ] || tama_log_subagent_attempt skipped pane_cleared "$attempt" "$target" \
          "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" "$before_derived" \
          "$before_count" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_DISPLAY" 0
      fi
      return 0
    fi

    if subagent_settled "$verb" "$TAMA_PANE_SUBAGENTS" "$id"; then
      # The read-back is also the one chance to notice that the other half of the
      # pane moved underneath this write. A state report and a subagent event each
      # judge the refresh from the half they did not write, and the pair an agent
      # ends a turn with — its own `idle` and its last subagent stopping — arrives
      # together. Whoever finishes second and finds the screen owed an update pays
      # for it here, rather than leaving it wrong until the next status tick.
      [ "$refresh" = 'yes' ] ||
        ! tama_pane_display_changed "$was" "$TAMA_PANE_DISPLAY" ||
        tama_summary_refresh_window "$TAMA_PANE_WINDOW_ID"
      [ "$logging" = no ] || tama_log_subagent_attempt applied '' "$attempt" "$target" \
        "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" "$before_derived" \
        "$before_count" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_DISPLAY" "$after_count"
      return 0
    fi

    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
      [ "$logging" = no ] || tama_log_subagent_attempt failed retries_exhausted "$TAMA_SUBAGENT_ATTEMPTS" \
        "$target" "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" \
        "$before_derived" "$before_count" "$TAMA_PANE_STATE_MAIN" \
        "$TAMA_PANE_DISPLAY" "$after_count"
      return 0
    fi
    [ "$logging" = no ] || tama_log_subagent_attempt skipped write_conflict "$((attempt - 1))" "$target" \
      "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" "$before_derived" \
      "$before_count" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_DISPLAY" "$after_count"
    # Not worth a word on stderr from inside an agent's hook if this shell's sleep
    # cannot do fractions; the delay is a courtesy, not a requirement.
    sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
  done
}

# A `state clear` that lands under either kind of subagent write wins. Only clear
# removes the main state, so seeing one disappear proves that any list left behind
# is this write's residue, not live state belonging to a pane that still has an
# agent. This is also why reconciliation does not need a lock or revision number.
subagent_clear_won() { # <pane_id> <had_main_state>
  TAMA_SUBAGENT_CLEAR_STATUS=applied
  [ -n "$2" ] && [ -z "$TAMA_PANE_STATE_MAIN" ] || return 1

  if [ -n "$TAMA_PANE_SUBAGENTS" ]; then
    tama_batch_reset
    tama_pane_stage "$1" subagents '' "$TAMA_PANE_SUBAGENTS"
    # A pane with no main state draws nothing; clear already requested its redraw.
    tama_batch_flush 'no' || true
    [ "$TAMA_BATCH_WRITE_STATUS" != failed ] || TAMA_SUBAGENT_CLEAR_STATUS=failed
  fi
  return 0
}

# Replaces the incremental set only when a caller has an authoritative snapshot.
# Claude Code 2.1.228 was observed stopping an internal agent under a different id
# than the one it started, so guessing which id to remove would sometimes hide real
# work. A complete provider snapshot can instead replace the set without weakening
# unknown `subagent-stop` into an arbitrary decrement.
reconcile_subagents() { # <pane> <space-separated-live-ids>
  local target="$1" wanted="$2" was refresh='no' was_agent_pane logging=no
  local before_count=0 after_count=0 before_derived=''
  if ! tama_pane_read "$target"; then
    tama_log_command_result skipped
    exit 0
  fi
  target="$TAMA_PANE_ID"
  was="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
  was_agent_pane="$TAMA_PANE_STATE_MAIN"
  if [ -n "${TAMA_LOG_FILE:-}" ]; then
    logging=yes
    before_derived="$was"
    tama_subagents_count "$TAMA_PANE_SUBAGENTS"
    before_count="$TAMA_SUBAGENTS_COUNT"
  fi

  tama_pane_display_changed "$was" "$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$wanted")" && refresh='yes'

  tama_batch_reset
  tama_pane_stage "$target" subagents "$wanted" "$TAMA_PANE_SUBAGENTS"
  if ! tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID"; then
    [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
      subagent_state_unchanged "$target" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    return 0
  fi

  if ! tama_pane_read "$target"; then
    [ "$logging" = no ] || tama_log_state_decision reconcile_subagents failed \
      read_pane_state_failed "$target" '' '' "$before_derived" "$before_count" \
      '' "$before_derived" "$before_count"
    return 0
  fi
  if [ "$logging" = yes ]; then
    tama_subagents_count "$TAMA_PANE_SUBAGENTS"
    after_count="$TAMA_SUBAGENTS_COUNT"
  fi
  if subagent_clear_won "$target" "$was_agent_pane"; then
    if [ "$TAMA_SUBAGENT_CLEAR_STATUS" = failed ]; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents failed \
        clear_residue_failed "$target" "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" \
        "$before_derived" "$before_count" "$TAMA_PANE_STATE_MAIN" \
        "$TAMA_PANE_DISPLAY" "$after_count"
    else
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
        pane_cleared "$target" "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" \
        "$before_derived" "$before_count" "$TAMA_PANE_STATE_MAIN" \
        "$TAMA_PANE_DISPLAY" 0
    fi
    return 0
  fi

  if [ "$logging" = yes ]; then
    if [ "$TAMA_BATCH_WRITE_STATUS" = applied ]; then
      tama_log_state_decision reconcile_subagents applied '' "$target" \
        "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" "$before_derived" \
        "$before_count" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_DISPLAY" "$after_count"
    else
      tama_log_state_decision reconcile_subagents failed write_pane_record_failed \
        "$target" "$TAMA_PANE_WINDOW_ID" "$was_agent_pane" \
        "$before_derived" "$before_count" "$TAMA_PANE_STATE_MAIN" \
        "$TAMA_PANE_DISPLAY" "$after_count"
    fi
  fi

  # As with incremental writes, a concurrent main-state report may be the half
  # that changed what the screen shows. The writer that observes it pays the
  # refresh instead of leaving the display stale until the next status interval.
  [ "$refresh" = 'yes' ] ||
    ! tama_pane_display_changed "$was" "$TAMA_PANE_DISPLAY" ||
    tama_summary_refresh_window "$TAMA_PANE_WINDOW_ID"
}

# Whether the list now says what this call needed it to say.
subagent_settled() { # <verb> <list> <id>
  if tama_subagents_contains "$2" "$3"; then
    [ "$1" = 'subagent-start' ]
  else
    [ "$1" = 'subagent-stop' ]
  fi
}

# A hook that passes a value the pane record cannot hold has to hear about it: the
# value would come back changed, or shift every field after it, and the pane would
# then never recognise itself again — so every later report would write and wake
# every client for nothing. The rule itself belongs to the record; see lib/pane.sh.
check_storable() { # <what> <value>
  # The value itself is not quoted back: the characters that make it illegal are
  # exactly the ones that would rewind the terminal over the sentence naming them.
  tama_pane_value_is_storable "$2" ||
    die_usage "$1 cannot contain a newline or a control separator"
}

# The id is what the plugin is being asked to track, and it travels in a
# space-separated list — so a missing one leaves nothing to do but say so, and a
# whitespace one would silently become several.
check_subagent_id() { # <verb> <id>
  [ -n "$2" ] || die_usage "$1 needs a subagent id"
  check_storable "a subagent id" "$2"
  case "$2" in
    *[[:space:]]*) die_usage "a subagent id cannot contain whitespace: $2" ;;
  esac
}

# Agent ids travel inside option names and the encoded agent record, so the
# rule is stricter than the subagent one: only letters, digits, dot,
# underscore, and dash survive both intact.
check_agent_reconcile_id() { # <id>
  [ -n "$1" ] || die_usage 'agent-reconcile needs an agent id'
  tama_agent_id_is_valid "$1" ||
    die_usage "an agent id may only hold letters, digits, dot, underscore, and dash: $1"
}

# Subagent ids inside an agent entry travel in the encoded agent record, so
# the structural `= / , ;` characters cannot survive them — unlike the flat
# list, which only forbids whitespace. Loud here, because the write two
# layers down would otherwise fail silently into a no-op.
check_agent_subagent_id() { # <verb> <id>
  [ -n "$2" ] || die_usage "$1 needs a subagent id"
  tama_agent_id_is_valid "$2" ||
    die_usage "a per-agent subagent id may only hold letters, digits, dot, underscore, and dash: $2"
}

# Reports one agent entry's main state, registering the entry on first sight.
# Mirrors report(): the same snapshot is staged, only a changed display redraws
# every client, and waiting/error raise the flag on the event, not the write.
#
# The record is shared, so this verifies its own slice on read-back and merges
# again on conflict, with the same bounded attempts as the flat subagent list:
# several writers reporting different agents in one pane would otherwise
# clobber each other, and the last flush would win.
agent_report() { # <pane> <agent> <state> <name>
  local pane="$1" agent="$2" state_main="$3" name="$4" refresh='no' attempt=1
  local state_before_derived='' state_after_derived logged_after_main outcome reason subagent_count=0
  local snapshot_cmd snapshot_cwd record base_subs base_record
  if [ -n "${TAMA_LOG_FILE:-}" ]; then
    logged_after_main="$state_main"
  fi
  while :; do
    if ! tama_pane_read "$pane"; then
      tama_log_command_result skipped
      exit 0
    fi
    # From here on the pane is addressed by its own id, like agent_subagent.
    pane="$TAMA_PANE_ID"
    base_record="$TAMA_PANE_AGENTS"
    if [ -n "${TAMA_LOG_FILE:-}" ]; then
      tama_subagents_count "$TAMA_PANE_SUBAGENTS"
      subagent_count="$TAMA_SUBAGENTS_COUNT"
    fi
    # Unconditional like the legacy path: the refresh decision compares the
    # display before and after, and an empty before would redraw on every
    # no-change report.
    state_before_derived="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
    base_subs="$(tama_agents_subs "$TAMA_PANE_AGENTS" "$agent")" || base_subs=''

    record="$(tama_agents_set_state "$TAMA_PANE_AGENTS" "$agent" "$state_main")" || {
      tama_log_command_result failed
      exit 0
    }
    state_after_derived="$(tama_pane_agent_display "$record" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
    refresh='no'
    tama_pane_display_changed "$state_before_derived" "$state_after_derived" && refresh='yes'

    # Re-read before staging: a concurrent writer that moved the record after
    # our read would be clobbered by a flush computed from the stale base.
    # Looping around merges from the fresh record instead, bounded like every
    # other write here. A read failure leaves the computed write alone: the
    # flush below decides whether it landed.
    if tama_pane_read "$pane" && [ "$TAMA_PANE_AGENTS" != "$base_record" ]; then
      [ "$logging" = no ] || tama_log_state_decision report_state skipped \
        write_conflict "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
        "$state_before_derived" "$subagent_count" "$TAMA_PANE_STATE_MAIN" \
        "$state_before_derived" "$subagent_count"
      attempt=$((attempt + 1))
      if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
        [ "$logging" = no ] || tama_log_state_decision report_state failed \
          retries_exhausted "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
          "$state_before_derived" "$subagent_count" "$TAMA_PANE_STATE_MAIN" \
          "$state_before_derived" "$subagent_count"
        return 0
      fi
      sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
      continue
    fi
    base_subs="$(tama_agents_subs "$TAMA_PANE_AGENTS" "$agent")" || base_subs=''

    snapshot_cmd="$TAMA_PANE_CURRENT_CMD" snapshot_cwd="$TAMA_PANE_CURRENT_PATH"
    tama_pane_value_is_storable "$snapshot_cmd" || snapshot_cmd=''
    tama_pane_value_is_storable "$snapshot_cwd" || snapshot_cwd=''

    tama_batch_reset
    tama_pane_stage "$TAMA_PANE_ID" agents "$record" "$TAMA_PANE_AGENTS"
    tama_pane_stage "$TAMA_PANE_ID" cmd "$snapshot_cmd" "$TAMA_PANE_CMD"
    tama_pane_stage "$TAMA_PANE_ID" agent "${name:-$TAMA_PANE_AGENT}" "$TAMA_PANE_AGENT"
    tama_pane_stage "$TAMA_PANE_ID" cwd "$snapshot_cwd" "$TAMA_PANE_CWD"
    tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID" || true

    if [ "$TAMA_BATCH_WRITE_STATUS" = skipped ]; then
      # Nothing staged: nothing could have been clobbered, so the read-back
      # round trip is skipped and the repeated report stays free.
      if [ -n "${TAMA_LOG_FILE:-}" ]; then
        tama_log_state_decision report_state skipped pane_record_unchanged \
          "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
          "$state_before_derived" "$subagent_count" "$logged_after_main" \
          "$state_after_derived" "$subagent_count"
      fi
      break
    fi
    if [ "$TAMA_BATCH_WRITE_STATUS" = failed ]; then
      if [ -n "${TAMA_LOG_FILE:-}" ]; then
        tama_log_state_decision report_state failed write_pane_record_failed \
          "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
          "$state_before_derived" "$subagent_count" "$TAMA_PANE_STATE_MAIN" \
          "$state_before_derived" "$subagent_count"
      fi
      # The flag below still answers to the event, not the write.
      break
    fi

    # Our own slice, not the whole record: a neighbour's concurrent write is
    # their business, and only our entry decides whether we settled.
    if ! tama_pane_read "$pane"; then
      if [ -n "${TAMA_LOG_FILE:-}" ]; then
        tama_log_state_decision report_state failed read_pane_state_failed \
          "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
          "$state_before_derived" "$subagent_count" "$TAMA_PANE_STATE_MAIN" \
          "$state_before_derived" "$subagent_count"
      fi
      break
    fi
    if tama_agents_entry_matches "$TAMA_PANE_AGENTS" "$agent" "$state_main" "$base_subs"; then
      if [ -n "${TAMA_LOG_FILE:-}" ]; then
        outcome="$TAMA_BATCH_WRITE_STATUS"
        reason=''
        [ "$outcome" = skipped ] && reason=pane_record_unchanged
        tama_log_state_decision report_state "$outcome" "$reason" "$TAMA_PANE_ID" \
          "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" \
          "$subagent_count" "$logged_after_main" "$state_after_derived" "$subagent_count"
      fi
      break
    fi
    if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent"; then
      # A clear landed after our flush: standing down is the only move that
      # does not resurrect it.
      if [ -n "${TAMA_LOG_FILE:-}" ]; then
        tama_log_state_decision report_state skipped pane_cleared "$TAMA_PANE_ID" \
          "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" \
          "$subagent_count" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" "$subagent_count"
      fi
      return 0
    fi

    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
      if [ -n "${TAMA_LOG_FILE:-}" ]; then
        tama_log_state_decision report_state failed retries_exhausted "$TAMA_PANE_ID" \
          "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" \
          "$subagent_count" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" "$subagent_count"
      fi
      break
    fi
    if [ -n "${TAMA_LOG_FILE:-}" ]; then
      tama_log_state_decision report_state skipped write_conflict "$TAMA_PANE_ID" \
        "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" \
        "$subagent_count" "$TAMA_PANE_STATE_MAIN" "$state_before_derived" "$subagent_count"
    fi
    sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
  done

  # Deliberately after the flush and outside it, like the legacy path: the flag
  # answers to the *event*, and an agent already in `waiting` that asks again
  # stages nothing above.
  case "$state_main" in
    waiting | error)
      TAMA_FLAG_WRITE_STATUS=''
      tama_flag_raise_automatic "$TAMA_PANE_ID"
      if [ -n "${TAMA_LOG_FILE:-}" ] && [ -n "$TAMA_FLAG_WRITE_STATUS" ]; then
        tama_log_effect effect.completed flag_write "e-$$-${RANDOM:-0}" \
          "$TAMA_FLAG_WRITE_STATUS" '' ''
      fi
      ;;
  esac
}

# Removes one agent entry. When the entry is absent there is nothing to unset;
# when the record empties and no other trace is left, the pane is
# indistinguishable from one that never ran an agent — the same rule clear
# itself follows.
#
# The record is shared, so this verifies the removal on read-back and merges
# again on conflict, with the same bounded attempts as the flat subagent
# list: a concurrent report that landed between our read and our flush is
# newer than the unregister decision, so a second consecutive mismatch stands
# down instead of spinning against a live agent.
agent_clear() { # <pane> <agent>
  local pane="$1" agent="$2" refresh='no' logging=no before_derived='' before_count=0 attempt=1
  local record after_derived base_record
  while :; do
    if ! tama_pane_read "$pane"; then
      tama_log_command_result skipped
      exit 0
    fi
    # From here on the pane is addressed by its own id, like agent_subagent.
    pane="$TAMA_PANE_ID"
    base_record="$TAMA_PANE_AGENTS"
    if [ -n "${TAMA_LOG_FILE:-}" ]; then
      logging=yes
      tama_subagents_count "$TAMA_PANE_SUBAGENTS"
      before_count="$TAMA_SUBAGENTS_COUNT"
    fi
    # Unconditional: without the real before display, removing the last entry
    # compares empty against empty and never redraws the icon away.
    before_derived="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"

    record="$(tama_agents_remove "$TAMA_PANE_AGENTS" "$agent")" || {
      tama_log_command_result failed
      exit 0
    }
    if [ "$record" = "$TAMA_PANE_AGENTS" ]; then
      [ "$logging" = no ] || tama_log_state_decision clear_state skipped \
        pane_record_unchanged "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    after_derived="$(tama_pane_agent_display "$record" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
    refresh='no'
    tama_pane_display_changed "$before_derived" "$after_derived" && refresh='yes'

    # Re-read before staging: a concurrent report that landed after our read
    # would be clobbered by a flush computed from the stale base. Looping
    # around merges the removal into the fresh record instead.
    if tama_pane_read "$pane"; then
      if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent" && [ "$TAMA_PANE_AGENTS" != "$base_record" ]; then
        # Someone else already removed it: nothing left for this call to do.
        [ "$logging" = no ] || tama_log_state_decision clear_state skipped \
          pane_record_unchanged "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
        return 0
      fi
      if [ "$TAMA_PANE_AGENTS" != "$base_record" ]; then
        [ "$logging" = no ] || tama_log_state_decision clear_state skipped \
          write_conflict "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
        attempt=$((attempt + 1))
        if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
          [ "$logging" = no ] || tama_log_state_decision clear_state failed \
            retries_exhausted "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" \
            "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
            "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
          return 0
        fi
        sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
        continue
      fi
    fi

    tama_batch_reset
    tama_pane_stage "$TAMA_PANE_ID" agents "$record" "$TAMA_PANE_AGENTS"
    tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID" || true
    if [ "$TAMA_BATCH_WRITE_STATUS" = failed ]; then
      if [ "$logging" = yes ]; then
        tama_log_state_decision clear_state failed write_pane_record_failed \
          "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
          "$before_derived" "$before_count" "$TAMA_PANE_STATE_MAIN" \
          "$before_derived" "$before_count"
      fi
      return 0
    fi

    # The entry must be gone and nothing else may have moved: a concurrent
    # report that landed under our flush is newer than this unregister.
    if ! tama_pane_read "$pane"; then
      if [ "$logging" = yes ]; then
        tama_log_state_decision clear_state failed read_pane_state_failed \
          "$TAMA_PANE_ID" "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" \
          "$before_derived" "$before_count" "$TAMA_PANE_STATE_MAIN" \
          "$before_derived" "$before_count"
      fi
      return 0
    fi
    if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent" &&
      [ "$(tama_agents_remove "$TAMA_PANE_AGENTS" "$agent")" = "$record" ]; then
      if [ "$logging" = yes ]; then
        tama_log_state_decision clear_state applied '' "$TAMA_PANE_ID" \
          "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$before_derived" \
          "$before_count" '' '' 0
      fi
      return 0
    fi

    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
      # A live agent keeps reporting under the clear: stand down instead of
      # spinning against it; the next explicit unregister starts fresh.
      if [ "$logging" = yes ]; then
        tama_log_state_decision clear_state skipped write_conflict "$TAMA_PANE_ID" \
          "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$before_derived" \
          "$before_count" "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      fi
      return 0
    fi
    if [ "$logging" = yes ]; then
      tama_log_state_decision clear_state skipped write_conflict "$TAMA_PANE_ID" \
        "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$before_derived" \
        "$before_count" "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    fi
    sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
  done
}

# Adds or removes a subagent id on one agent entry, with the same optimistic
# read-modify-write as the flat list: verify our own slice on read-back, retry
# a bounded number of times, and never resurrect an entry a clear or a
# reconcile took away while this call was in flight.
agent_subagent() { # <pane> <agent> <verb> <id>
  local target="$1" agent="$2" verb="$3" id="$4" attempt=1 wanted was refresh
  local entry_subs new_subs base_record had_entry
  local before_count=0 after_count=0 before_derived='' logging=no
  check_agent_subagent_id "$verb" "$id"
  [ -n "${TAMA_LOG_FILE:-}" ] && logging=yes
  while :; do
    if ! tama_pane_read "$target"; then
      tama_log_command_result skipped
      exit 0
    fi
    target="$TAMA_PANE_ID"
    was="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
    if [ "$logging" = yes ]; then
      before_derived="$was"
      tama_subagents_count "$TAMA_PANE_SUBAGENTS"
      before_count="$TAMA_SUBAGENTS_COUNT"
    fi
    base_record="$TAMA_PANE_AGENTS"
    if tama_agents_has "$base_record" "$agent"; then had_entry=yes; else had_entry=no; fi

    entry_subs="$(tama_agents_subs "$TAMA_PANE_AGENTS" "$agent")" || entry_subs=''
    # Stopping an id on an entry that is not there is a no-op, like the flat list.
    if [ "$verb" = subagent-stop ] && [ "$had_entry" = no ]; then
      [ "$logging" = no ] || tama_log_subagent_attempt skipped \
        subagent_state_unchanged "$attempt" "$target" "$TAMA_PANE_WINDOW_ID" \
        '' "$before_derived" "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi

    case "$verb" in
      subagent-start)
        tama_subagents_add "$entry_subs" "$id"
        new_subs="$TAMA_SUBAGENTS_NEW"
        ;;
      subagent-stop)
        tama_subagents_remove "$entry_subs" "$id"
        new_subs="$TAMA_SUBAGENTS_NEW"
        ;;
    esac
    wanted="$(tama_agents_set_subs "$TAMA_PANE_AGENTS" "$agent" "$new_subs")" || {
      tama_log_command_result failed
      return 0
    }

    refresh='no'
    tama_pane_display_changed "$was" "$(tama_pane_agent_display "$wanted" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")" && refresh='yes'

    # Re-read before staging: a clear landing between the read above and the
    # flush below would be resurrected by it, and a concurrent writer's slice
    # would be clobbered by it. A vanished entry stands down — unless it was
    # never there, which is the ordinary first-time tracking this command
    # exists for. Anything else merges by looping around and rebuilding from
    # the fresh record, bounded like every other write here.
    if ! tama_pane_read "$target"; then
      [ "$logging" = no ] || tama_log_subagent_attempt failed \
        read_pane_state_failed "$attempt" "$target" '' '' \
        "$before_derived" "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi
    if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent"; then
      if [ "$had_entry" = yes ]; then
        [ "$logging" = no ] || tama_log_subagent_attempt skipped pane_cleared "$attempt" "$target" \
          "$TAMA_PANE_WINDOW_ID" '' "$before_derived" \
          "$before_count" '' "$before_derived" "$before_count"
        return 0
      fi
    elif [ "$TAMA_PANE_AGENTS" != "$base_record" ]; then
      [ "$logging" = no ] || tama_log_subagent_attempt skipped write_conflict "$attempt" "$target" \
        "$TAMA_PANE_WINDOW_ID" '' "$before_derived" \
        "$before_count" '' "$before_derived" "$before_count"
      attempt=$((attempt + 1))
      if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
        [ "$logging" = no ] || tama_log_subagent_attempt failed retries_exhausted "$TAMA_SUBAGENT_ATTEMPTS" \
          "$target" "$TAMA_PANE_WINDOW_ID" '' "$before_derived" \
          "$before_count" '' "$before_derived" "$before_count"
        return 0
      fi
      sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
      continue
    fi

    tama_batch_reset
    tama_pane_stage "$target" agents "$wanted" "$TAMA_PANE_AGENTS"
    if ! tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID"; then
      [ "$logging" = no ] || tama_log_subagent_attempt skipped \
        subagent_state_unchanged "$attempt" "$target" "$TAMA_PANE_WINDOW_ID" \
        '' "$before_derived" "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi

    if [ "$TAMA_BATCH_WRITE_STATUS" = failed ]; then
      [ "$logging" = no ] || tama_log_subagent_attempt failed \
        write_pane_record_failed "$attempt" "$target" '' '' \
        "$before_derived" "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi

    if ! tama_pane_read "$target"; then
      [ "$logging" = no ] || tama_log_subagent_attempt failed \
        read_pane_state_failed "$attempt" "$target" '' '' \
        "$before_derived" "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi

    # The entry vanishing under this write means a clear or a reconcile took it
    # away: standing down is the only move that does not resurrect it.
    if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent"; then
      [ "$logging" = no ] || tama_log_subagent_attempt skipped pane_cleared "$attempt" "$target" \
        "$TAMA_PANE_WINDOW_ID" '' "$before_derived" \
        "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi

    entry_subs="$(tama_agents_subs "$TAMA_PANE_AGENTS" "$agent")" || entry_subs=''
    if [ "$verb" = subagent-start ]; then
      if tama_subagents_contains "$entry_subs" "$id"; then settled=yes; else settled=no; fi
    else
      if tama_subagents_contains "$entry_subs" "$id"; then settled=no; else settled=yes; fi
    fi
    if [ "$settled" = yes ]; then
      [ "$refresh" = 'yes' ] ||
        ! tama_pane_display_changed "$was" "$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")" ||
        tama_summary_refresh_window "$TAMA_PANE_WINDOW_ID"
      if [ "$logging" = yes ]; then
        tama_subagents_count "$TAMA_PANE_SUBAGENTS"
        after_count="$TAMA_SUBAGENTS_COUNT"
        tama_log_subagent_attempt applied '' "$attempt" "$target" \
          "$TAMA_PANE_WINDOW_ID" '' "$before_derived" \
          "$before_count" '' "$before_derived" "$after_count"
      fi
      return 0
    fi

    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
      [ "$logging" = no ] || tama_log_subagent_attempt failed retries_exhausted "$TAMA_SUBAGENT_ATTEMPTS" \
        "$target" "$TAMA_PANE_WINDOW_ID" '' "$before_derived" \
        "$before_count" '' "$before_derived" "$before_count"
      return 0
    fi
    [ "$logging" = no ] || tama_log_subagent_attempt skipped write_conflict "$((attempt - 1))" "$target" \
      "$TAMA_PANE_WINDOW_ID" '' "$before_derived" \
      "$before_count" '' "$before_derived" "$before_count"
    sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
  done
}

# Replaces one entry's subagent list with an authoritative snapshot, without
# weakening the stop of an unknown id into an arbitrary decrement. An unknown
# agent is left alone: a reconcile describes what is live, and inventing an
# entry for it would draw attention to nothing.
agent_reconcile_subs() { # <pane> <agent> <space-separated-live-ids>
  local pane="$1" agent="$2" reconcile_list="$3" refresh='no' was='' wanted='' attempt=1 base_record=''
  local before_derived='' before_count=0 logging=no
  [ -n "${TAMA_LOG_FILE:-}" ] && logging=yes
  local id subs=''
  set -f
  # shellcheck disable=SC2086 # deliberate: the reconcile list is space separated
  for id in $reconcile_list; do
    check_agent_subagent_id subagent-reconcile "$id"
    tama_subagents_add "$subs" "$id"
    subs="$TAMA_SUBAGENTS_NEW"
  done
  set +f
  while :; do
    if ! tama_pane_read "$pane"; then
      tama_log_command_result skipped
      exit 0
    fi
    pane="$TAMA_PANE_ID"
    base_record="$TAMA_PANE_AGENTS"
    was="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
    if [ "$logging" = yes ]; then
      before_derived="$was"
      tama_subagents_count "$TAMA_PANE_SUBAGENTS"
      before_count="$TAMA_SUBAGENTS_COUNT"
    fi
    if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent"; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
        subagent_state_unchanged "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    wanted="$(tama_agents_set_subs "$TAMA_PANE_AGENTS" "$agent" "$subs")" || {
      tama_log_command_result failed
      return 0
    }
    refresh='no'
    tama_pane_display_changed "$was" "$(tama_pane_agent_display "$wanted" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")" && refresh='yes'

    # Re-read before staging: a concurrent writer that moved the record after
    # our read would be clobbered by a flush computed from the stale base.
    # Looping around merges from the fresh record instead, bounded like every
    # other write here. A vanished entry stands down: the snapshot describes
    # what is live, and inventing it would draw attention to nothing.
    if tama_pane_read "$pane"; then
      if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent"; then
        [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
          pane_cleared "$pane" "$TAMA_PANE_WINDOW_ID" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
        return 0
      fi
      if [ "$TAMA_PANE_AGENTS" != "$base_record" ]; then
        [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
          write_conflict "$pane" "$TAMA_PANE_WINDOW_ID" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
          "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
        attempt=$((attempt + 1))
        if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
          [ "$logging" = no ] || tama_log_state_decision reconcile_subagents failed \
            retries_exhausted "$attempt" "$pane" "$TAMA_PANE_WINDOW_ID" \
            "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
            "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
          return 0
        fi
        sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
        continue
      fi
    fi

    tama_batch_reset
    tama_pane_stage "$pane" agents "$wanted" "$TAMA_PANE_AGENTS"
    if ! tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID"; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
        subagent_state_unchanged "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    if [ "$TAMA_BATCH_WRITE_STATUS" = skipped ]; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
        subagent_state_unchanged "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    if [ "$TAMA_BATCH_WRITE_STATUS" = failed ]; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents failed \
        write_pane_record_failed "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    if ! tama_pane_read "$pane"; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents failed \
        read_pane_state_failed "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    if [ "$(tama_agents_subs "$TAMA_PANE_AGENTS" "$agent" 2>/dev/null)" = "$subs" ]; then
      if [ "$logging" = yes ]; then
        tama_log_state_decision reconcile_subagents applied '' "$pane" \
          "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$before_derived" \
          "$before_count" "$TAMA_PANE_STATE_MAIN" \
          "$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")" "$before_count"
      fi
      return 0
    fi
    if ! tama_agents_has "$TAMA_PANE_AGENTS" "$agent"; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
        pane_cleared "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi

    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
      [ "$logging" = no ] || tama_log_state_decision reconcile_subagents failed \
        retries_exhausted "$attempt" "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    [ "$logging" = no ] || tama_log_state_decision reconcile_subagents skipped \
      write_conflict "$attempt" "$pane" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
  done
}

# Replaces the agent set with an authoritative snapshot: listed ids survive
# with state and subagents intact, anything else is dropped. Nothing listed
# empties the record. Ghost healing for integrations that can enumerate their
# live agents; integrations that cannot keep using explicit unregister.
# With a namespace, only entries under it are reconciled: stored entries
# outside the namespace survive untouched, so integrations sharing a pane
# never drop each other's agents.
agent_reconcile() { # <pane> <space-separated-live-ids> [namespace]
  local pane="$1" reconcile_list="$2" namespace="${3:-}" refresh='no' was='' wanted='' attempt=1
  local before_derived='' before_count=0 logging=no
  [ -n "${TAMA_LOG_FILE:-}" ] && logging=yes
  local id want_fresh
  set -f
  # shellcheck disable=SC2086 # deliberate: the reconcile list is space separated
  for id in $reconcile_list; do
    check_agent_reconcile_id "$id"
    # A bare id would silently sort as foreign and survive; be loud instead.
    if [ -n "$namespace" ]; then
      case "$id" in
        "$namespace"*) ;;
        *) die_usage "agent-reconcile --namespace $namespace only lists ids under it: $id" ;;
      esac
    fi
  done
  if [ -n "$namespace" ]; then
    check_agent_reconcile_id "$namespace"
  fi
  set +f
  local base_record=''
  while :; do
    if ! tama_pane_read "$pane"; then
      tama_log_command_result skipped
      exit 0
    fi
    pane="$TAMA_PANE_ID"
    base_record="$TAMA_PANE_AGENTS"
  was="$(tama_pane_agent_display "$TAMA_PANE_AGENTS" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")"
  if [ "$logging" = yes ]; then
    before_derived="$was"
    tama_subagents_count "$TAMA_PANE_SUBAGENTS"
    before_count="$TAMA_SUBAGENTS_COUNT"
  fi
  if [ -n "$namespace" ]; then
    check_agent_reconcile_id "$namespace"
    set -f
    # shellcheck disable=SC2086 # deliberate: word splitting is the point here
    wanted="$(tama_agents_prune_namespace "$TAMA_PANE_AGENTS" "$namespace" $reconcile_list)" || {
      set +f
      tama_log_command_result failed
      exit 0
    }
    set +f
  else
    set -f
    # shellcheck disable=SC2086 # deliberate: word splitting is the point here
    wanted="$(tama_agents_prune "$TAMA_PANE_AGENTS" $reconcile_list)" || {
      set +f
      tama_log_command_result failed
      exit 0
    }
    set +f
  fi
  refresh='no'
  tama_pane_display_changed "$was" "$(tama_pane_agent_display "$wanted" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")" && refresh='yes'

  # Re-read before staging: a concurrent writer that moved the record after
  # our read would be clobbered by a flush computed from the stale base.
  # Looping around merges from the fresh record instead, bounded like every
  # other write here.
  if tama_pane_read "$pane" && [ "$TAMA_PANE_AGENTS" != "$base_record" ]; then
    [ "$logging" = no ] || tama_log_state_decision agent_reconcile skipped \
      write_conflict "$pane" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    attempt=$((attempt + 1))
    if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
      [ "$logging" = no ] || tama_log_state_decision agent_reconcile failed \
        retries_exhausted "$attempt" "$pane" "$TAMA_PANE_WINDOW_ID" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
        "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
      return 0
    fi
    sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
    continue
  fi

  tama_batch_reset
  tama_pane_stage "$pane" agents "$wanted" "$TAMA_PANE_AGENTS"
  if ! tama_batch_flush "$refresh" "$TAMA_PANE_WINDOW_ID"; then
    [ "$logging" = no ] || tama_log_state_decision agent_reconcile skipped \
      pane_record_unchanged "$pane" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    return 0
  fi
  if [ "$TAMA_BATCH_WRITE_STATUS" = skipped ]; then
    [ "$logging" = no ] || tama_log_state_decision agent_reconcile skipped \
      pane_record_unchanged "$pane" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    return 0
  fi
  if [ "$TAMA_BATCH_WRITE_STATUS" = failed ]; then
    [ "$logging" = no ] || tama_log_state_decision agent_reconcile failed \
      write_pane_record_failed "$pane" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    return 0
  fi
  if ! tama_pane_read "$pane"; then
    [ "$logging" = no ] || tama_log_state_decision agent_reconcile failed \
      read_pane_state_failed "$pane" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    return 0
  fi
  # The snapshot must still describe the record: a concurrent writer that
  # landed under our flush means the set moved on.
  set -f
  if [ -n "$namespace" ]; then
    # shellcheck disable=SC2086 # deliberate: word splitting is the point here
    want_fresh="$(tama_agents_prune_namespace "$TAMA_PANE_AGENTS" "$namespace" $reconcile_list)" || want_fresh=''
  else
    # shellcheck disable=SC2086 # deliberate: word splitting is the point here
    want_fresh="$(tama_agents_prune "$TAMA_PANE_AGENTS" $reconcile_list)" || want_fresh=''
  fi
  set +f
  if [ "$want_fresh" = "$wanted" ]; then
    if [ "$logging" = yes ]; then
      tama_log_state_decision agent_reconcile applied '' "$pane" \
        "$TAMA_PANE_WINDOW_ID" "$TAMA_PANE_STATE_MAIN" "$before_derived" \
        "$before_count" "$TAMA_PANE_STATE_MAIN" \
        "$(tama_pane_agent_display "$wanted" "$TAMA_PANE_STATE_MAIN" "$TAMA_PANE_SUBAGENTS")" "$before_count"
    fi
    return 0
  fi

  attempt=$((attempt + 1))
  if [ "$attempt" -gt "$TAMA_SUBAGENT_ATTEMPTS" ]; then
    [ "$logging" = no ] || tama_log_state_decision agent_reconcile failed \
      retries_exhausted "$attempt" "$pane" "$TAMA_PANE_WINDOW_ID" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
      "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
    return 0
  fi
  [ "$logging" = no ] || tama_log_state_decision agent_reconcile skipped \
    write_conflict "$attempt" "$pane" "$TAMA_PANE_WINDOW_ID" \
    "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count" \
    "$TAMA_PANE_STATE_MAIN" "$before_derived" "$before_count"
  sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
  done
}

# Accumulates one list-valued argument for the reconcile verbs, shared by the
# `--` and positional parse paths and by every position after the state, so
# the four call sites cannot drift apart again. Writes to the caller's
# `reconcile`, `reconcile_agents`, and `argument` (dynamic scope); exits usage
# on anything else in rest position.
accumulate_reconcile_arg() { # <state> <arg|rest> <value>
  case "$1" in
    subagent-reconcile)
      check_subagent_id "$1" "$3"
      tama_subagents_add "$reconcile" "$3"
      reconcile="$TAMA_SUBAGENTS_NEW"
      ;;
    agent-reconcile)
      check_agent_reconcile_id "$3"
      reconcile_agents="${reconcile_agents:+$reconcile_agents }$3"
      ;;
    *)
      if [ "$2" = rest ]; then
        die_usage "state takes at most two arguments, got: $3"
      fi
      argument="$3"
      ;;
  esac
}

main() {
  local pane='' agent='' namespace='' keep_agents='no' state='' argument='' reconcile='' reconcile_agents='' positional=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --pane)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--pane needs a pane id'
        fi
        pane="$2"
        shift 2
        ;;
      --agent)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--agent needs an agent id'
        fi
        agent="$2"
        shift 2
        ;;
      --namespace)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--namespace needs a namespace prefix'
        fi
        namespace="$2"
        shift 2
        ;;
      --keep-agents)
        keep_agents='yes'
        shift
        ;;
      --)
        # Everything after this is a value, so an opaque id the agent chose can
        # begin with a dash.
        shift
        while [ "$#" -gt 0 ]; do
          positional=$((positional + 1))
          case "$positional" in
            1) state="$1" ;;
            2) accumulate_reconcile_arg "$state" arg "$1" ;;
            *) accumulate_reconcile_arg "$state" rest "$1" ;;
          esac
          shift
        done
        ;;
      -*) die_usage "unknown option: $1" ;;
      *)
        positional=$((positional + 1))
        case "$positional" in
          1) state="$1" ;;
          2) accumulate_reconcile_arg "$state" arg "$1" ;;
          *) accumulate_reconcile_arg "$state" rest "$1" ;;
        esac
        shift
        ;;
    esac
  done

  # An empty one counts as missing: that is a hook that failed to interpolate its
  # variable, not a state from a version that does not exist yet.
  [ -n "$state" ] || die_usage 'state needs a state'

  # Agent-scoped reports address one entry of the pane's agent record. The id
  # is validated up front like every other shape: a value the record cannot
  # hold would corrupt its neighbours.
  if [ -n "$agent" ]; then
    tama_agent_id_is_valid "$agent" ||
      die_usage "an agent id may only hold letters, digits, dot, underscore, and dash: $agent"
  fi

  # The shape of the call is checked before anything about the environment, because
  # a wrong hook must be loud wherever it runs, while the environment being wrong is
  # one of the quiet no-ops.
  case "$state" in
    running | waiting | idle | error)
      # The name is stored and later expanded into a notification title, so it must
      # survive the round trip through a tmux option intact.
      check_storable "an agent name" "$argument"
      ;;
    subagent-start | subagent-stop)
      check_subagent_id "$state" "$argument"
      # Per-agent entries additionally constrain the id to the record charset;
      # fail here, loudly, rather than in the write two layers down.
      if [ -n "$agent" ]; then check_agent_subagent_id "$state" "$argument"; fi
      ;;
    agent-reconcile)
      [ -z "$agent" ] || die_usage 'agent-reconcile takes no --agent; it replaces the whole agent set'
      if [ -n "$namespace" ]; then
        tama_agent_id_is_valid "$namespace" ||
          die_usage "a namespace may only hold letters, digits, dot, underscore, and dash: $namespace"
        case "$namespace" in
          *-) ;;
          *) die_usage "a namespace must end in a dash so it cannot prefix-match a foreign id: $namespace" ;;
        esac
      fi
      ;;
  esac

  # Scope flags belong to one verb each; unknown states stay quiet for forward
  # compatibility, so only known states are checked.
  case "$state" in
    running | waiting | idle | error | clear | subagent-start | subagent-stop | subagent-reconcile)
      [ -z "$namespace" ] || die_usage '--namespace only applies to agent-reconcile'
      if [ "$keep_agents" = yes ]; then
        [ "$state" = clear ] && [ -z "$agent" ] ||
          die_usage '--keep-agents only applies to a pane-wide clear'
      fi
      ;;
  esac

  # --pane overrides the pane the hook happens to run in, which wrappers lose and
  # tests never have. Having neither is one of the quiet no-ops — there is no pane
  # to write state on, and an agent's turn must not fail over it.
  pane="${pane:-${TMUX_PANE:-}}"
  [ -n "$pane" ] || exit 0

  case "$state" in
    running | waiting | idle | error)
      if [ -n "$agent" ]; then
        agent_report "$pane" "$agent" "$state" "$argument"
      else
        report "$pane" "$state" "$argument"
      fi
      ;;
    clear)
      if [ -n "$agent" ]; then
        agent_clear "$pane" "$agent"
      else
        clear_pane "$pane" "$keep_agents"
      fi
      ;;
    subagent-start | subagent-stop)
      if [ -n "$agent" ]; then
        agent_subagent "$pane" "$agent" "$state" "$argument"
      else
        subagent "$pane" "$state" "$argument"
      fi
      ;;
    subagent-reconcile)
      if [ -n "$agent" ]; then
        agent_reconcile_subs "$pane" "$agent" "$reconcile"
      else
        reconcile_subagents "$pane" "$reconcile"
      fi
      ;;
    agent-reconcile) agent_reconcile "$pane" "$reconcile_agents" "$namespace" ;;
    # Not a state this version knows. Quiet on purpose: agents grow event types, and
    # a hook written for a newer plugin has to stay silent on an older one rather
    # than fail the turn it is reporting on.
    *) exit 0 ;;
  esac
}

main "$@"

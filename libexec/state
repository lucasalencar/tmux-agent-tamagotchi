#!/usr/bin/env bash
#
# state — an agent pane reports what it is doing.
#
#   tama state <running|waiting|idle|error|clear> [agent_name] [--pane <pane_id>]
#   tama state subagent-start <id> [--pane <pane_id>]
#   tama state subagent-stop  <id> [--pane <pane_id>]
#
# Called from an agent's hooks, so the shape of an invocation is the contract and
# the failure policy matters more than the feature: a wrong hook exits 2 loudly
# while its author is editing it, and everything else — no pane, a state this
# version does not know — exits 0 silently rather than failing an agent's turn.
#
# The agent name is optional and sticky: reporting a state without one keeps the
# name already recorded, so only the hook that has the name has to pass it. It is
# ignored by `clear`, which removes it along with everything else.
#
# A state this plugin does not know is not a hook author's mistake to shout
# about: agents grow event types, and a hook wired to a newer plugin must stay
# quiet on an older one.
#
# Note for whoever adds the window flag: nothing here writes when nothing changed,
# so anything that must happen on the *event* rather than on the change — raising a
# flag for a question the user has already dismissed once — cannot live behind that
# short-circuit.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

# The optimistic loop below, in numbers: attempts in total, not retries after the
# first. Constants rather than options for now — nothing has asked to tune them,
# and the failure they guard is benign.
TAMA_SUBAGENT_ATTEMPTS=5
TAMA_SUBAGENT_RETRY_DELAY=0.05

# Records a state, plus the snapshot that stale-state detection needs later to
# notice the agent is gone. Writes only what changed, and nothing at all when
# nothing did: the `running` state is reported on every tool call, which makes this
# the one genuinely hot write path in the plugin. Skipping the write skips the
# client refresh with it, which is the expensive half.
report() {
  local pane="$1" state_main="$2" name="$3" refresh='no'
  tama_pane_read "$pane" || exit 0

  # Only a different icon is worth redrawing every client for; a pane whose command
  # or path merely moved is a cheap write and nothing a user can see.
  tama_pane_derive "$state_main" "$TAMA_PANE_SUBAGENTS"
  tama_pane_display_changed "$TAMA_PANE_DISPLAY" "$TAMA_PANE_DERIVED" && refresh='yes'

  # The snapshot comes from tmux, not from the hook, so a value the record cannot
  # hold is nobody's mistake to be told about — but storing it would shift every
  # field after it on the next read and leave the pane unable to recognise itself.
  # A pane in a directory named like that simply has no snapshot.
  local snapshot_cmd="$TAMA_PANE_CURRENT_CMD" snapshot_cwd="$TAMA_PANE_CURRENT_PATH"
  tama_pane_value_is_storable "$snapshot_cmd" || snapshot_cmd=''
  tama_pane_value_is_storable "$snapshot_cwd" || snapshot_cwd=''

  # Staged as <new> then <stored>: the snapshot_ values are what the pane is doing
  # now, the others what it last said. Swapping the pair in the `cmd` or `cwd` line
  # would silently invert the comparison stale-state detection makes.
  tama_batch_reset
  tama_pane_stage "$TAMA_PANE_ID" state_main "$state_main" "$TAMA_PANE_STATE_MAIN"
  tama_pane_stage "$TAMA_PANE_ID" cmd "$snapshot_cmd" "$TAMA_PANE_CMD"
  tama_pane_stage "$TAMA_PANE_ID" agent "${name:-$TAMA_PANE_AGENT}" "$TAMA_PANE_AGENT"
  tama_pane_stage "$TAMA_PANE_ID" cwd "$snapshot_cwd" "$TAMA_PANE_CWD"
  # Not error handling: a flush with nothing staged says so by its status, and this
  # is the last command of the script, so without this the hot path — a repeated
  # `state running` — would exit non-zero out of an agent's hook.
  tama_batch_flush "$refresh" || true
}

# Removes every trace of the agent from the pane. Unsetting rather than emptying
# is the whole point: a cleared pane must be indistinguishable from a pane that
# never ran an agent, and it is also what heals a subagent id that leaked.
#
# The options are listed out because each needs the value already read for it,
# which is what keeps clearing a pane that was never an agent pane free. The test
# asks the pane whether anything of ours is left rather than checking these names,
# so an option added later and forgotten here fails there.
clear_pane() {
  local pane="$1" refresh='no'
  tama_pane_read "$pane" || exit 0

  # Clearing an agent pane takes an icon away, which is a change a user sees.
  tama_pane_display_changed "$TAMA_PANE_DISPLAY" '' && refresh='yes'

  tama_batch_reset
  tama_pane_stage "$TAMA_PANE_ID" state_main '' "$TAMA_PANE_STATE_MAIN"
  tama_pane_stage "$TAMA_PANE_ID" subagents '' "$TAMA_PANE_SUBAGENTS"
  tama_pane_stage "$TAMA_PANE_ID" cmd '' "$TAMA_PANE_CMD"
  tama_pane_stage "$TAMA_PANE_ID" agent '' "$TAMA_PANE_AGENT"
  tama_pane_stage "$TAMA_PANE_ID" cwd '' "$TAMA_PANE_CWD"
  # As in report(): nothing staged is not a failure, and this is the exit status.
  tama_batch_flush "$refresh" || true
}

# Adds or removes a subagent id, and recomputes the display state with it, since
# whether any subagent is live is what tells `background` from `idle`.
#
# Note for whoever adds the window flag: `report` writes nothing when nothing
# changed, so anything that must happen on the *event* rather than on the change —
# raising a flag for a question the user has already dismissed once — cannot live
# behind that short-circuit.
#
# tmux has no atomic read-modify-write, so the list is maintained optimistically:
# read, modify, write, read back, and try again from a fresh read if the list no
# longer says what this call needed it to say. Everything an attempt decides — what
# the list should become, whether the screen changes — is decided inside the loop,
# from the read that attempt made.
#
# What "worked" means is the caller's own id, not the list: a start is done when
# its id is there and a stop when its id is gone. Comparing the whole list instead
# would read somebody else's concurrent start as a lost race, and rewriting the
# list read before it would then drop *their* id.
#
# The read-back sees only the writers that landed before it, so this is still racy
# and deliberately not locked. What the retries buy is the interleaving where the
# loser is still looking: it notices its id gone and puts it back. What they cannot
# buy is the one where both writers verify before the other lands — measured at
# 4 in 120 with three concurrent starts and 10 in 120 with four — and then an id is
# lost, which makes a pane with a live subagent look finished until the pane is
# cleared. Nothing puts it back, because the stop for an id that is not in the list
# is a no-op.
#
# Two directions are accepted for the same reason. A leaked id makes the pane look
# busier than it is and is healed by the next `state clear` or sweep; a retried
# start can resurrect an id a concurrent stop had just removed, which lands in the
# same benign direction. What must never be resurrected is a pane a `state clear`
# has taken away, because clear is what the healing story rests on — see the
# read-back. All of it is bookkeeping without a compare-and-swap: a lock
# in a shell script invoked on every subagent event would cost more, on every event,
# than a wrong glyph on a few.
subagent() {
  local target="$1" verb="$2" id="$3" attempt=1 wanted was refresh was_agent_pane
  while :; do
    tama_pane_read "$target" || exit 0
    # From here on the pane is addressed by its own id: a target given by index
    # could come to mean another pane while this loop is still running.
    target="$TAMA_PANE_ID"
    was="$TAMA_PANE_DISPLAY"
    # Whether this was an agent pane at all when the attempt started, which is how
    # the read-back below tells a `state clear` from a lost race.
    was_agent_pane="$TAMA_PANE_STATE_MAIN"

    case "$verb" in
      subagent-start) tama_subagents_add "$TAMA_PANE_SUBAGENTS" "$id" ;;
      subagent-stop) tama_subagents_remove "$TAMA_PANE_SUBAGENTS" "$id" ;;
    esac
    wanted="$TAMA_SUBAGENTS_NEW"

    tama_pane_derive "$TAMA_PANE_STATE_MAIN" "$wanted"
    refresh='no'
    tama_pane_display_changed "$was" "$TAMA_PANE_DERIVED" && refresh='yes'

    tama_batch_reset
    tama_pane_stage "$target" subagents "$wanted" "$TAMA_PANE_SUBAGENTS"
    # Nothing to write: a duplicate start, or a stop for an id that is not there.
    tama_batch_flush "$refresh" || return 0

    tama_pane_read "$target" || return 0

    # A `state clear` that landed under this write wins, and has to: the whole
    # promise of clearing is that the pane becomes indistinguishable from one that
    # never ran an agent, and only `clear` ever takes the main state away. Without
    # this the loop reads the clear as a lost race — from here the two look the same,
    # the id it needed is not in the list — and puts the id back, on a pane nothing
    # draws, where nothing heals it: `clear` was named as the cure. The next agent in
    # that pane then reports `idle` and renders `background` forever.
    #
    # The mirror interleaving lands here too, with the id present rather than gone:
    # a write that arrived after `clear` read the pane and before its batch, whose
    # residue is this call's own list. Either way the pane is not an agent pane, so
    # there is nothing for a subagent list to qualify — it goes.
    if [ -n "$was_agent_pane" ] && [ -z "$TAMA_PANE_STATE_MAIN" ]; then
      if [ -n "$TAMA_PANE_SUBAGENTS" ]; then
        tama_batch_reset
        tama_pane_stage "$target" subagents '' "$TAMA_PANE_SUBAGENTS"
        # No refresh: a pane with no main state draws nothing either way, and the
        # clear that got here first already asked for the redraw its icon needed.
        tama_batch_flush 'no' || true
      fi
      return 0
    fi

    if subagent_settled "$verb" "$TAMA_PANE_SUBAGENTS" "$id"; then
      # The read-back is also the one chance to notice that the other half of the
      # pane moved underneath this write. A state report and a subagent event each
      # judge the refresh from the half they did not write, and the pair an agent
      # ends a turn with — its own `idle` and its last subagent stopping — arrives
      # together. Whoever finishes second and finds the screen owed an update pays
      # for it here, rather than leaving it wrong until the next status tick.
      [ "$refresh" = 'yes' ] ||
        ! tama_pane_display_changed "$was" "$TAMA_PANE_DISPLAY" ||
        tmux_run refresh-client -S >/dev/null 2>&1 || true
      return 0
    fi

    attempt=$((attempt + 1))
    [ "$attempt" -le "$TAMA_SUBAGENT_ATTEMPTS" ] || return 0
    # Not worth a word on stderr from inside an agent's hook if this shell's sleep
    # cannot do fractions; the delay is a courtesy, not a requirement.
    sleep "$TAMA_SUBAGENT_RETRY_DELAY" 2>/dev/null || true
  done
}

# Whether the list now says what this call needed it to say.
subagent_settled() { # <verb> <list> <id>
  if tama_subagents_contains "$2" "$3"; then
    [ "$1" = 'subagent-start' ]
  else
    [ "$1" = 'subagent-stop' ]
  fi
}

# A hook that passes a value the pane record cannot hold has to hear about it: the
# value would come back changed, or shift every field after it, and the pane would
# then never recognise itself again — so every later report would write and wake
# every client for nothing. The rule itself belongs to the record; see lib/pane.sh.
check_storable() { # <what> <value>
  # The value itself is not quoted back: the characters that make it illegal are
  # exactly the ones that would rewind the terminal over the sentence naming them.
  tama_pane_value_is_storable "$2" ||
    die_usage "$1 cannot contain a newline or a control separator"
}

# The id is what the plugin is being asked to track, and it travels in a
# space-separated list — so a missing one leaves nothing to do but say so, and a
# whitespace one would silently become several.
check_subagent_id() { # <verb> <id>
  [ -n "$2" ] || die_usage "$1 needs a subagent id"
  check_storable "a subagent id" "$2"
  case "$2" in
    *[[:space:]]*) die_usage "a subagent id cannot contain whitespace: $2" ;;
  esac
}

main() {
  local pane='' state='' argument='' positional=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --pane)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--pane needs a pane id'
        fi
        pane="$2"
        shift 2
        ;;
      --)
        # Everything after this is a value, so an opaque id the agent chose can
        # begin with a dash.
        shift
        while [ "$#" -gt 0 ]; do
          positional=$((positional + 1))
          case "$positional" in
            1) state="$1" ;;
            2) argument="$1" ;;
            *) die_usage "state takes at most two arguments, got: $1" ;;
          esac
          shift
        done
        ;;
      -*) die_usage "unknown option: $1" ;;
      *)
        positional=$((positional + 1))
        case "$positional" in
          1) state="$1" ;;
          2) argument="$1" ;;
          *) die_usage "state takes at most two arguments, got: $1" ;;
        esac
        shift
        ;;
    esac
  done

  # An empty one counts as missing: that is a hook that failed to interpolate its
  # variable, not a state from a version that does not exist yet.
  [ -n "$state" ] || die_usage 'state needs a state'

  # The shape of the call is checked before anything about the environment, because
  # a wrong hook must be loud wherever it runs, while the environment being wrong is
  # one of the quiet no-ops.
  case "$state" in
    running | waiting | idle | error)
      # The name is stored and later expanded into a notification title, so it must
      # survive the round trip through a tmux option intact.
      check_storable "an agent name" "$argument"
      ;;
    subagent-start | subagent-stop) check_subagent_id "$state" "$argument" ;;
  esac

  # --pane overrides the pane the hook happens to run in, which wrappers lose and
  # tests never have. Having neither is one of the quiet no-ops — there is no pane
  # to write state on, and an agent's turn must not fail over it.
  pane="${pane:-${TMUX_PANE:-}}"
  [ -n "$pane" ] || exit 0

  case "$state" in
    running | waiting | idle | error) report "$pane" "$state" "$argument" ;;
    clear) clear_pane "$pane" ;;
    subagent-start | subagent-stop) subagent "$pane" "$state" "$argument" ;;
    # Not a state this version knows. Quiet on purpose: agents grow event types, and
    # a hook written for a newer plugin has to stay silent on an older one rather
    # than fail the turn it is reporting on.
    *) exit 0 ;;
  esac
}

main "$@"

#!/usr/bin/env bash
#
# dismiss [--agent <agent_id>] [--pane <pane_id>] [<window_target>] — take down
# the banner a window has pending. With --agent only that agent's banner goes
# down; without it the legacy banner and every agent banner go down, so
# acknowledgement by navigation clears the whole window at once.
#
#   tama dismiss [--agent <agent_id>] [--pane <pane_id>] [<window_target>]
#
# The user arriving at a window is what normally calls this, through `tama
# on-select`: notification centre should not accumulate things already dealt with.
# It is here as a subcommand of its own for a key binding, and because a user who
# wants the banner gone without visiting the window should not have to visit it.
#
# Unconditional, unlike the mark it goes with: whoever calls this is saying the
# banner has served its purpose. A pending banner keeps the group `notify` used to
# raise it, so changing @tama_group_format cannot make it impossible to dismiss.
#
# Never fails: a banner that would not go away is not worth a word out of an agent's
# hook or a line in the server log.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  local agent='' pane='' target='' positional=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--agent needs an agent id'
        fi
        [ -z "$agent" ] || die_usage '--agent may only be given once'
        agent="$2"
        shift 2
        ;;
      --pane)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--pane needs a pane id'
        fi
        pane="$2"
        shift 2
        ;;
      -*) die_usage "unknown option: $1" ;;
      *)
        positional=$((positional + 1))
        [ "$positional" -eq 1 ] || die_usage "dismiss takes at most one target, got: $1"
        [ -n "$1" ] || die_usage "dismiss needs a window target"
        target="$1"
        shift
        ;;
    esac
  done
  if [ -n "$agent" ]; then
    tama_agent_id_is_valid "$agent" ||
      die_usage "an agent id may only hold letters, digits, dot, underscore, and dash: $agent"
  fi

  # shellcheck disable=SC2034  # read by the caller after parsing
  TAMA_WINDOW_TARGET="${target:-${pane:-${TMUX_PANE:-}}}"
  if [ -z "$TAMA_WINDOW_TARGET" ]; then
    tama_log_command_result skipped
    exit 0
  fi

  # With banners off there is nothing of ours on screen to take down, and asking the
  # backend would start a notifier process to say so.
  if ! tama_notify_enabled; then
    tama_log_command_result skipped
    exit 0
  fi

  if ! tama_window_read "$TAMA_WINDOW_TARGET"; then
    tama_log_command_result skipped
    exit 0
  fi
  tama_notify_dismiss "$agent"
  tama_log_command_result "$TAMA_NOTIFY_DISMISS_STATUS"
}

main "$@"

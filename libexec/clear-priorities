#!/usr/bin/env bash
#
#   tama clear-priorities

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  [ "$#" -eq 0 ] || die_usage "clear-priorities takes no arguments, got: $1"

  local records window_id priority failures=0
  records="$(tmux_run list-windows -a \
    -F "#{window_id} #{${TAMA_WINDOW_PRIORITY_OPTION}}" 2>/dev/null | LC_ALL=C sort -u)" ||
    return 1

  while IFS=' ' read -r window_id priority; do
    [ -n "$priority" ] || continue
    tmux_run set -wuq -t "$window_id" "$TAMA_WINDOW_PRIORITY_OPTION" ||
      failures=$((failures + 1))
  done <<EOF
$records
EOF

  tmux_run refresh-client -S >/dev/null 2>&1 || true

  if [ "$failures" -ne 0 ]; then
    printf 'tama: could not clear Priority from %s tmux window%s\n' \
      "$failures" "$( [ "$failures" -eq 1 ] || printf s )" >&2
    return 1
  fi
}

main "$@"

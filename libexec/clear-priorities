#!/usr/bin/env bash
#
#   tama clear-priorities [--session <session_id>]

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

tama_session_id_is_immutable() { # <session_id>
  case "$1" in
    \$*) ;;
    *) return 1 ;;
  esac
  case "${1#\$}" in
    '' | *[!0-9]*) return 1 ;;
  esac
}

main() {
  local session=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --session)
        [ -z "$session" ] || die_usage 'clear-priorities accepts --session once'
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--session needs a session id'
        fi
        case "$2" in
          -*) die_usage '--session needs a session id' ;;
        esac
        tama_session_id_is_immutable "$2" ||
          die_usage '--session needs an immutable session id'
        session="$2"
        shift 2
        ;;
      -*) die_usage "unknown option: $1" ;;
      *) die_usage "clear-priorities takes no positional arguments, got: $1" ;;
    esac
  done

  local records record window_id has_priority failures=0
  if ! records="$(tama_priority_records "$session")"; then
    if [ -n "$session" ]; then
      printf 'tama: cannot clear Priority: session %s is unavailable\n' "$session" >&2
    fi
    return 1
  fi

  while IFS= read -r record; do
    [ -n "$record" ] || continue
    window_id="${record%% *}"
    has_priority="${record#* }"
    [ "$has_priority" = 1 ] || continue
    tmux_run set -wuq -t "$window_id" "$TAMA_WINDOW_PRIORITY_OPTION" ||
      failures=$((failures + 1))
  done <<EOF
$records
EOF

  tmux_run refresh-client -S >/dev/null 2>&1 || true

  if [ "$failures" -ne 0 ]; then
    printf 'tama: could not clear Priority from %s tmux window%s\n' \
      "$failures" "$( [ "$failures" -eq 1 ] || printf s )" >&2
    return 1
  fi
}

main "$@"

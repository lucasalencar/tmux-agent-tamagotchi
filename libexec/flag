#!/usr/bin/env bash
#
# flag — mark a window as wanting the user's attention.
#
#   tama flag [--pane <pane_id>] [<window_target>]
#
# `state waiting` and `state error` raise the flag themselves, so a hook rarely
# needs this; it is here for a user's own key binding and for the integrations that
# report something the state model has no word for.
#
# Raising is conditional, and the condition is the point: a window the user is
# already looking at is not flagged, because the flag means "this happened while
# nobody was looking". The condition itself lives in lib/window.sh, shared with
# notification suppression — there is exactly one implementation of it.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  tama_optional_window_target flag "$@"
  [ -n "$TAMA_WINDOW_TARGET" ] || exit 0

  tama_flag_raise "$TAMA_WINDOW_TARGET"
}

main "$@"

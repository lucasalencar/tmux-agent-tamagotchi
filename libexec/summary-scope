#!/usr/bin/env bash
#
#   tama summary-scope --session <session_id> current|all|toggle
#
# Selects the status-summary inventory scope for one explicit tmux session.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

tama_summary_scope_refresh() { # <session id>
  local clients client
  clients="$(tmux_run list-clients -t "$1" -F '#{client_name}' 2>/dev/null)" || return 0
  while IFS= read -r client; do
    [ -n "$client" ] || continue
    tmux_run refresh-client -S -t "$client" >/dev/null 2>&1 || true
  done <<EOF
$clients
EOF
}

main() {
  [ "$#" -gt 0 ] || die_usage 'summary-scope needs --session <session_id>'
  [ "$1" = '--session' ] || die_usage 'summary-scope needs --session first'
  if [ "$#" -le 1 ] || [ -z "$2" ]; then
    die_usage '--session needs a session id'
  fi
  [ "$#" -eq 3 ] || die_usage 'summary-scope needs exactly one scope'

  local target="$2" requested="$3" session_id current wanted
  case "$requested" in
    current | all | toggle) ;;
    *) die_usage 'summary-scope scope must be current, all, or toggle' ;;
  esac

  session_id="$(tama_inventory_session_id "$target")" || {
    tama_log_command_result failed
    return 0
  }
  if [ -z "$session_id" ]; then
    tama_log_command_result skipped
    return 0
  fi
  current="$(tama_summary_scope "$session_id")" || {
    tama_log_command_result failed
    return 0
  }

  if [ "$requested" = 'toggle' ]; then
    case "$current" in
      current) wanted='all' ;;
      all) wanted='current' ;;
    esac
  else
    wanted="$requested"
  fi

  tmux_run set-option -t "$session_id" @tama_summary_scope "$wanted" >/dev/null 2>&1 || {
    tama_log_command_result failed
    return 0
  }
  tama_log_command_result applied
  [ "$wanted" = "$current" ] || tama_summary_scope_refresh "$session_id"
}

main "$@"

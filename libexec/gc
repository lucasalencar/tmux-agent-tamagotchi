#!/usr/bin/env bash
#
#   tama gc [--all] [--window <window_id>] [--pane <pane_id>] [<target>]
#
# Pane-selection hooks sweep one window; terminal-focus hooks use `--all` because
# that rarer event is when the user sees the whole status line.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  local all='no' window='' pane='' target='' positional=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all)
        all='yes'
        shift
        ;;
      --window)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--window needs a window id'
        fi
        window="$2"
        shift 2
        ;;
      --pane)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--pane needs a pane id'
        fi
        pane="$2"
        shift 2
        ;;
      -*) die_usage "unknown option: $1" ;;
      *)
        positional=$((positional + 1))
        [ "$positional" -eq 1 ] || die_usage "gc takes at most one target, got: $1"
        # An empty one is a binding or a recipe that failed to interpolate its
        # format, not a request for whichever window tmux would pick.
        [ -n "$1" ] || die_usage 'gc needs a target'
        target="$1"
        shift
        ;;
    esac
  done

  if [ "$all" = 'yes' ]; then
    # Deliberately not an error together with a target: `on-select --all` passes the
    # window it was called for so it can unflag it, and the sweep it asks for here is
    # the whole server either way. A target is about which window, and --all says
    # that question does not apply.
    tama_stale_sweep_server
    tama_log_command_result "$TAMA_STALE_SWEEP_STATUS"
    return 0
  fi

  # A target given outright wins over the pane a key binding runs in, the same order
  # libexec/flag uses. With none of them, tmux resolves the current window itself —
  # one round trip, only on the path a user typed by hand, and it keeps `tama gc`
  # meaning something on its own.
  target="${target:-${window:-${pane:-${TMUX_PANE:-}}}}"
  if [ -z "$target" ]; then
    target="$(tmux_run display-message -p '#{window_id}' 2>/dev/null)" || target=''
    # No window to sweep and nothing to say about it.
    if [ -z "$target" ]; then
      tama_log_command_result skipped
      return 0
    fi
  fi

  tama_stale_sweep_window "$target"
  tama_log_command_result "$TAMA_STALE_SWEEP_STATUS"
}

main "$@"

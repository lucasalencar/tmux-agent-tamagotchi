#!/usr/bin/env bash
#
# gc — clear the state of panes whose agent is gone.
#
#   tama gc [--all] [--window <window_id>] [--pane <pane_id>] [<target>]
#
# Wired to `after-select-pane` by the entrypoint, and reached through `on-select` on
# window selection and on the user's terminal regaining focus. It is also the command
# to run by hand, or from a key binding, when the status line is showing an agent that
# has clearly been dead for ten minutes.
#
# Scope is the whole point of the two forms. The default is one window, because a
# pane selection happens constantly and the user is looking at exactly one window
# when it does: one `list-panes` and, in the ordinary case where nothing is stale, no
# write at all. `--all` is every pane on the server, which is affordable only because
# the event it hangs off — the terminal regaining focus — is rare, and is exactly the
# moment the user is about to read the whole status line at once.
#
# The target may be a pane or a window; tmux resolves either to the window that holds
# it, which is the scope. `--window` is what the hook recipes pass, because inside a
# hook's `run-shell` $TMUX_PANE names a pane that does not exist — see libexec/on-select.
# With no target at all the current window is swept, which is what a user typing
# `tama gc` means.
#
# How staleness is decided, and why it is not `kill -0`, is in lib/stale.sh.
#
# Never fails: this runs from a tmux hook, where a non-zero exit is noise in the
# server log and nothing a user can act on.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  local all='no' window='' pane='' target='' positional=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all)
        all='yes'
        shift
        ;;
      --window)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--window needs a window id'
        fi
        window="$2"
        shift 2
        ;;
      --pane)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
          die_usage '--pane needs a pane id'
        fi
        pane="$2"
        shift 2
        ;;
      -*) die_usage "unknown option: $1" ;;
      *)
        positional=$((positional + 1))
        [ "$positional" -eq 1 ] || die_usage "gc takes at most one target, got: $1"
        # An empty one is a binding or a recipe that failed to interpolate its
        # format, not a request for whichever window tmux would pick.
        [ -n "$1" ] || die_usage 'gc needs a target'
        target="$1"
        shift
        ;;
    esac
  done

  if [ "$all" = 'yes' ]; then
    # Deliberately not an error together with a target: `on-select --all` passes the
    # window it was called for so it can unflag it, and the sweep it asks for here is
    # the whole server either way. A target is about which window, and --all says
    # that question does not apply.
    tama_stale_sweep_server
    return 0
  fi

  # A target given outright wins over the pane a key binding runs in, the same order
  # libexec/flag uses. With none of them, tmux resolves the current window itself —
  # one round trip, only on the path a user typed by hand, and it keeps `tama gc`
  # meaning something on its own.
  target="${target:-${window:-${pane:-${TMUX_PANE:-}}}}"
  if [ -z "$target" ]; then
    target="$(tmux_run display-message -p '#{window_id}' 2>/dev/null)" || target=''
    # No window to sweep and nothing to say about it.
    [ -n "$target" ] || return 0
  fi

  tama_stale_sweep_window "$target"
}

main "$@"

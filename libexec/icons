#!/usr/bin/env bash
#
# icons — one glyph per agent pane of a window, in pane order.
#
#   tama icons <window_id>
#
# The hottest read path in the plugin: tmux runs this in a shell of its own, once
# per window per status-interval, for every window on the server. So it makes
# exactly one tmux call and forks nothing.
#
# The derived state is worked out here rather than read from an option of its own,
# because storing it needed two writers who could disagree — see lib/pane.sh. It
# costs nothing: the one call already read a pane option per pane, and now reads
# two.
#
# What this prints is expanded again as a tmux format by the status line that ran
# it, so it may only ever be glyphs from the table below. A value that reached
# stdout from an option would be a format the user did not write.
#
# The window is named by `#{window_id}`, never by index: an index moves under
# renumber-windows, and this command is invoked from a format that was expanded
# some moments earlier.
#
# v0.1 ships the default glyph set only. Making the glyphs, the disabled states
# and the spacing configurable is a separate change, and this is the file that
# grows those option reads when it lands.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  [ "$#" -eq 1 ] || die_usage 'icons needs exactly one window id'
  # An empty target is a status line that failed to expand its format, not a
  # request for whichever window tmux would pick.
  [ -n "$1" ] || die_usage 'icons needs a window id'

  local panes icons='' record
  # One line per pane, in pane order, holding what the pane last said about itself
  # and its live subagents. A pane that is not an agent pane says nothing. A window
  # that is gone — closed between the format expanding and this running — is not an
  # error worth a word on stdout.
  panes="$(tmux_run list-panes -t "$1" -F "$TAMA_PANE_RENDER_FORMAT" 2>/dev/null)" || exit 0

  # A here-document rather than a pipe: a pipe would put this loop in a subshell,
  # and this command exists to run without forking. Taking a record apart is the
  # library's job, so the field order is stated in one place.
  while IFS= read -r record; do
    tama_pane_derive_record "$record"
    case "$TAMA_PANE_DERIVED" in
      # The braces are not decoration: bash reads the bytes of a multibyte glyph
      # as part of the name in `$icons●`, and dies under `nounset`.
      running) icons="${icons}●" ;;
      waiting) icons="${icons}◐" ;;
      background) icons="${icons}⚙" ;;
      idle) icons="${icons}○" ;;
      error) icons="${icons}✕" ;;
      # A state from a newer version of the plugin, or from somebody else's
      # option of the same name: not ours to draw.
    esac
  done <<EOF
$panes
EOF

  # The prefix separates the icons from the window name, and exists only when
  # there is something to separate: a window with no agent pane must contribute
  # nothing at all to the status line, not even the stray space that padding
  # would leave. No trailing newline for the same reason.
  [ -n "$icons" ] || return 0
  printf ' %s' "$icons"
}

main "$@"

#!/usr/bin/env bash
#
#   tama set-remote-token [<token>]
#
# Stores the remote backend's shared secret in every place one server needs:
# the server environment (so later config reloads resolving $TAMA_REMOTE_TOKEN
# keep working), the @tama_remote_token option (so it applies immediately), and
# the unversioned env file new servers source from shell init. With no argument
# the token comes from $TAMA_REMOTE_TOKEN in this process instead of argv.
#
# Never prints the token back: argv already exposes it to ps while this runs,
# and stdout must not add another copy (doctor redacts it for the same reason).

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

# Where new servers find the secret. XDG location, unversioned by convention —
# shell init sources it before any tmux server starts.
tama_remote_token_file() {
  printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/tama/remote.env"
}

main() {
  local token='' positional=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --)
        # Everything after this is the value, so a token beginning with a dash
        # is a token rather than an option.
        shift
        while [ "$#" -gt 0 ]; do
          positional=$((positional + 1))
          case "$positional" in
            1) token="$1" ;;
            *) die_usage 'set-remote-token takes one token' ;;
          esac
          shift
        done
        ;;
      -*) die_usage "unknown option: $1" ;;
      *)
        positional=$((positional + 1))
        case "$positional" in
          1) token="$1" ;;
          *) die_usage 'set-remote-token takes one token' ;;
        esac
        shift
        ;;
    esac
  done

  [ -n "$token" ] || token="${TAMA_REMOTE_TOKEN:-}"
  [ -n "$token" ] || die_usage 'set-remote-token needs a token'

  tmux_run set-environment -g TAMA_REMOTE_TOKEN "$token" >/dev/null 2>&1 || {
    printf 'tama set-remote-token: could not update the tmux server environment\n' >&2
    exit 1
  }
  tmux_run set -g @tama_remote_token "$token" >/dev/null 2>&1 || {
    printf 'tama set-remote-token: could not set @tama_remote_token\n' >&2
    exit 1
  }

  # Persist for new servers, so the file and the server cannot drift apart.
  # Quoted with the plugin's own shell quoter: a quote in the token becomes the
  # close-open-escaped idiom and the file stays sourceable verbatim, including
  # under the bash 3.2 macOS ships (whose ${//} expansion differs from bash 4+).
  local token_file persisted
  persisted='nowhere (HOME is not set)'
  if [ -n "${HOME:-}" ]; then
    token_file="$(tama_remote_token_file)"
    if mkdir -p "${token_file%/*}" 2>/dev/null; then
      tama_shell_quote "$token"
      if printf 'export TAMA_REMOTE_TOKEN=%s\n' "$TAMA_QUOTED" \
        >"$token_file" 2>/dev/null &&
        chmod 600 "$token_file" 2>/dev/null; then
        persisted="$token_file"
      fi
    fi
  fi

  printf 'token stored for this tmux server (environment and @tama_remote_token)\n'
  printf 'persisted for new servers in %s\n' "$persisted"
  printf 'for new servers, export TAMA_REMOTE_TOKEN from an unversioned file in shell init\n'
}

main "$@"

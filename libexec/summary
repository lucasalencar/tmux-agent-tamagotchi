#!/usr/bin/env bash
#
#   tama summary <session_id>
#
# Compact count of unique agent panes in one session.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

tama_summary_read_pane() { # <pane id>; 0 state, 2 no state, 1 invalid read
  local raw field lines=0
  raw="$(tama_inventory_fields "$1" '#{pane_id}
#{@tama_pane_state_main}
#{@tama_pane_subagents}
.')" || return 1

  TAMA_SUMMARY_PANE_ID=''
  TAMA_SUMMARY_STATE=''
  TAMA_SUMMARY_SUBAGENTS=''
  while IFS= read -r field; do
    lines=$((lines + 1))
    case "$lines" in
      1) TAMA_SUMMARY_PANE_ID="$field" ;;
      2) TAMA_SUMMARY_STATE="$field" ;;
      3) TAMA_SUMMARY_SUBAGENTS="$field" ;;
    esac
  done <<EOF
$raw
EOF
  [ "$lines" -eq 4 ] && [ -n "$TAMA_SUMMARY_PANE_ID" ] || return 1
  [ -n "$TAMA_SUMMARY_STATE" ] || return 2
  tama_pane_derive "$TAMA_SUMMARY_STATE" "$TAMA_SUMMARY_SUBAGENTS"
  return 0
}

tama_summary_records() { # <session id>
  local session_id scope sessions session windows window_id panes pane_id read_status
  local seen=''
  session_id="$(tama_inventory_session_id "$1")" || return 1
  [ -n "$session_id" ] || return 1
  scope="$(tama_summary_scope "$session_id")" || return 1
  if [ "$scope" = 'all' ]; then
    sessions="$(tama_inventory_sessions)" || return 1
  else
    sessions="$session_id"
  fi

  while IFS= read -r session; do
    [ -n "$session" ] || continue
    windows="$(tama_inventory_windows "$session")" || return 1
    while IFS= read -r window_id; do
      [ -n "$window_id" ] || continue
      panes="$(tama_inventory_panes "$window_id")" || return 1
      while IFS= read -r pane_id; do
        [ -n "$pane_id" ] || continue
        case "$seen" in
          *"|$pane_id|"*) continue ;;
        esac
        seen="$seen|$pane_id|"

        tama_summary_read_pane "$pane_id"
        read_status=$?
        if [ "$read_status" -ne 0 ]; then
          [ "$read_status" -eq 2 ] && continue
          return 1
        fi
        printf '%s\n' "$TAMA_PANE_DERIVED"
      done <<EOF
$panes
EOF
    done <<EOF
$windows
EOF
  done <<EOF
$sessions
EOF
}

# shellcheck disable=SC2034  # inputs are consumed by lib/state-icons.sh
tama_summary_load_icons() {
  local value
  TAMA_ICON_SET="$(tama_opt tama_icon_set glyphs)"
  TAMA_ICON_HAS_RUNNING=0 TAMA_ICON_HAS_WAITING=0 TAMA_ICON_HAS_BACKGROUND=0
  TAMA_ICON_HAS_IDLE=0 TAMA_ICON_HAS_ERROR=0

  if value="$(tmux_run show -gv @tama_icon_running 2>/dev/null)"; then
    TAMA_ICON_HAS_RUNNING=1 TAMA_ICON_RUNNING="$value"
  fi
  if value="$(tmux_run show -gv @tama_icon_waiting 2>/dev/null)"; then
    TAMA_ICON_HAS_WAITING=1 TAMA_ICON_WAITING="$value"
  fi
  if value="$(tmux_run show -gv @tama_icon_background 2>/dev/null)"; then
    TAMA_ICON_HAS_BACKGROUND=1 TAMA_ICON_BACKGROUND="$value"
  fi
  if value="$(tmux_run show -gv @tama_icon_idle 2>/dev/null)"; then
    TAMA_ICON_HAS_IDLE=1 TAMA_ICON_IDLE="$value"
  fi
  if value="$(tmux_run show -gv @tama_icon_error 2>/dev/null)"; then
    TAMA_ICON_HAS_ERROR=1 TAMA_ICON_ERROR="$value"
  fi
  tama_state_icons_resolve
}

tama_summary_policy() { # <bucket>
  local bucket="$1" fallback value
  fallback="$(tama_summary_policy_default "$bucket")" || return 1
  value="$(tama_opt "tama_summary_show_$bucket" "$fallback")"
  if tama_summary_policy_is_valid "$value"; then
    printf '%s' "$value"
  else
    printf '%s' "$fallback"
  fi
}

tama_summary_add_bucket() { # <icon> <count> <policy>
  case "$3" in
    never) return 0 ;;
    nonzero) [ "$2" -ne 0 ] || return 0 ;;
  esac
  [ -z "$TAMA_SUMMARY_OUTPUT" ] ||
    TAMA_SUMMARY_OUTPUT="$TAMA_SUMMARY_OUTPUT$TAMA_SUMMARY_SEPARATOR"
  TAMA_SUMMARY_OUTPUT="$TAMA_SUMMARY_OUTPUT$1 $2"
}

main() {
  [ "$#" -eq 1 ] || die_usage 'summary needs exactly one session id'
  [ -n "$1" ] || die_usage 'summary needs a session id'
  case "$1" in
    -*) die_usage 'summary needs a session id' ;;
  esac

  local records state running=0 waiting=0 idle=0 background=0 error=0 unknown=0 unknown_icon
  local prefix suffix bucket bucket_icon bucket_count
  records="$(tama_summary_records "$1")" || return 0
  while IFS= read -r state; do
    [ -n "$state" ] || continue
    case "$state" in
      running) running=$((running + 1)) ;;
      waiting) waiting=$((waiting + 1)) ;;
      idle) idle=$((idle + 1)) ;;
      background) background=$((background + 1)) ;;
      error) error=$((error + 1)) ;;
      *) unknown=$((unknown + 1)) ;;
    esac
  done <<EOF
$records
EOF

  tama_summary_load_icons
  unknown_icon="$(tama_opt tama_icon_unknown '?')"
  prefix="$(tama_opt tama_summary_prefix '')"
  TAMA_SUMMARY_SEPARATOR="$(tama_opt tama_summary_separator ' ')"
  suffix="$(tama_opt tama_summary_suffix '')"
  TAMA_SUMMARY_OUTPUT=''
  while IFS= read -r bucket; do
    case "$bucket" in
      running) bucket_icon="$TAMA_GLYPH_RUNNING" bucket_count="$running" ;;
      waiting) bucket_icon="$TAMA_GLYPH_WAITING" bucket_count="$waiting" ;;
      idle) bucket_icon="$TAMA_GLYPH_IDLE" bucket_count="$idle" ;;
      background) bucket_icon="$TAMA_GLYPH_BACKGROUND" bucket_count="$background" ;;
      error) bucket_icon="$TAMA_GLYPH_ERROR" bucket_count="$error" ;;
      unknown) bucket_icon="$unknown_icon" bucket_count="$unknown" ;;
      *) return 0 ;;
    esac
    tama_summary_add_bucket "$bucket_icon" "$bucket_count" \
      "$(tama_summary_policy "$bucket")"
  done <<EOF
$TAMA_SUMMARY_BUCKETS
EOF
  TAMA_SUMMARY_OUTPUT="$prefix$TAMA_SUMMARY_OUTPUT$suffix"
  printf '%s' "${TAMA_SUMMARY_OUTPUT//\#/##}"
}

main "$@"

#!/usr/bin/env bash
#
# unflag — take the attention mark off a window.
#
#   tama unflag [--pane <pane_id>] [<window_target>]
#
# Unconditional, unlike `flag`: whoever calls this is saying the mark has been seen,
# and there is nothing to weigh. `tama on-select` is the caller that matters — the
# user selecting the window is the only thing that clears a flag in normal use.
#
# Nothing an agent does clears it. That asymmetry is the feature: the flag records
# that something happened while nobody was looking, so an agent moving on from
# `waiting` to `running` leaves it exactly where it was.

set -o nounset

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/common.sh
. "$TAMA_PLUGIN_DIR/lib/common.sh"

main() {
  tama_optional_window_target unflag "$@"
  [ -n "$TAMA_WINDOW_TARGET" ] || exit 0

  # The status says whether there was a mark to take off, which this command has no
  # use for and must not exit with: `tama unflag` on a window that was not marked has
  # done what was asked of it.
  tama_flag_clear "$TAMA_WINDOW_TARGET" || true
}

main "$@"

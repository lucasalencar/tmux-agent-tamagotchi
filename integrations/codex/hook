#!/usr/bin/env bash
# Codex lifecycle adapter. Codex-specific policy stays outside the stable core.

set -o nounset

[ -n "${TAMA_BIN:-}" ] || exit 0

TAMA_CODEX_AGENT='codex'
TAMA_CODEX_PAYLOAD=''
TAMA_CODEX_PAYLOAD_READ='no'
TAMA_CODEX_FIELD=''
TAMA_CODEX_TEXT=''
TAMA_CODEX_REST=''
TAMA_CODEX_PAYLOAD_MAX=65536
TAMA_CODEX_PAYLOAD_TIMEOUT=2
TAMA_CODEX_TEXT_MAX=500
TAMA_CODEX_ESCAPES_MAX=256

codex_read_payload() {
  [ "$TAMA_CODEX_PAYLOAD_READ" = 'no' ] || return 0
  TAMA_CODEX_PAYLOAD_READ='yes'
  [ -t 0 ] && return 0
  IFS= read -r -d '' -n "$TAMA_CODEX_PAYLOAD_MAX" \
    -t "$TAMA_CODEX_PAYLOAD_TIMEOUT" TAMA_CODEX_PAYLOAD || true
}

codex_locate_string() { # <field>
  TAMA_CODEX_REST=''
  codex_read_payload

  local rest="$TAMA_CODEX_PAYLOAD"
  case "$rest" in
    *"\"$1\""*) rest="${rest#*\""$1"\"}" ;;
    *) return 1 ;;
  esac
  rest="${rest#*:}"
  while :; do
    case "$rest" in
      [[:space:]]*) rest="${rest#?}" ;;
      *) break ;;
    esac
  done
  case "$rest" in
    '"'*) TAMA_CODEX_REST="${rest#\"}" ;;
    *) return 1 ;;
  esac
}

codex_locate_structured_string() { # <field> <object-depth> <array-depth>
  TAMA_CODEX_REST=''
  codex_read_payload

  # Delegation is signalled only by the common top-level agent_id. A tool is free
  # to use the same key inside tool_input, where treating it as delegation would
  # silently suppress a real question or approval request.
  local rest="$TAMA_CODEX_PAYLOAD" structural char raw before_quote before_escape probe
  local object_depth=0 array_depth=0
  case "$rest" in *"\"$1\""*) ;; *) return 1 ;; esac
  while :; do
    case "$rest" in *'"'*) ;; *) return 1 ;; esac
    structural="${rest%%\"*}"
    rest="${rest#*\"}"

    while [ -n "$structural" ]; do
      char="${structural:0:1}"
      structural="${structural#?}"
      case "$char" in
        '{') object_depth=$((object_depth + 1)) ;;
        '}') object_depth=$((object_depth - 1)) ;;
        '[') array_depth=$((array_depth + 1)) ;;
        ']') array_depth=$((array_depth - 1)) ;;
      esac
    done

    raw=''
    while :; do
      case "$rest" in *'"'*) ;; *) return 1 ;; esac
      before_quote="${rest%%\"*}"
      case "$rest" in
        *\\*) before_escape="${rest%%\\*}" ;;
        *) before_escape="$before_quote" ;;
      esac
      if [ "${#before_escape}" -ge "${#before_quote}" ]; then
        raw="$raw$before_quote"
        rest="${rest#*\"}"
        break
      fi
      raw="$raw$before_escape"
      rest="${rest#*\\}"
      [ -n "$rest" ] || return 1
      raw="$raw\\${rest:0:1}"
      rest="${rest#?}"
    done

    if [ "$object_depth" -eq "$2" ] && [ "$array_depth" -eq "$3" ] && [ "$raw" = "$1" ]; then
      probe="$rest"
      while :; do
        case "$probe" in [[:space:]]*) probe="${probe#?}" ;; *) break ;; esac
      done
      case "$probe" in :*) probe="${probe#:}" ;; *) continue ;; esac
      while :; do
        case "$probe" in [[:space:]]*) probe="${probe#?}" ;; *) break ;; esac
      done
      case "$probe" in
        '"'*) TAMA_CODEX_REST="${probe#\"}"; return 0 ;;
        *) return 1 ;;
      esac
    fi
  done
}

codex_locate_top_level_string() { # <field>
  codex_locate_structured_string "$1" 1 0
}

codex_token_field() { # <field>
  TAMA_CODEX_FIELD=''
  codex_locate_top_level_string "$1" || return 1
  TAMA_CODEX_FIELD="${TAMA_CODEX_REST%%\"*}"
  case "$TAMA_CODEX_FIELD" in
    '' | -* | *[!A-Za-z0-9_-]*) TAMA_CODEX_FIELD=''; return 1 ;;
  esac
}

TAMA_CODEX_CHAR=''

codex_utf8_char() { # <codepoint>
  local codepoint="$1" encoded
  TAMA_CODEX_CHAR=''
  # Bash 3.2 has no Unicode escape formatter. Build the UTF-8 bytes as octal so
  # valid JSON text remains useful without adding a JSON utility dependency.
  [ "$codepoint" -gt 0 ] || return 1
  if [ "$codepoint" -le 127 ]; then
    printf -v encoded '\\%03o' "$codepoint"
  elif [ "$codepoint" -le 2047 ]; then
    printf -v encoded '\\%03o\\%03o' \
      $((192 | codepoint >> 6)) $((128 | codepoint & 63))
  elif [ "$codepoint" -le 65535 ]; then
    printf -v encoded '\\%03o\\%03o\\%03o' \
      $((224 | codepoint >> 12)) $((128 | codepoint >> 6 & 63)) \
      $((128 | codepoint & 63))
  elif [ "$codepoint" -le 1114111 ]; then
    printf -v encoded '\\%03o\\%03o\\%03o\\%03o' \
      $((240 | codepoint >> 18)) $((128 | codepoint >> 12 & 63)) \
      $((128 | codepoint >> 6 & 63)) $((128 | codepoint & 63))
  else
    return 1
  fi
  printf -v TAMA_CODEX_CHAR '%b' "$encoded"
}

codex_text_field() { # <field> [location]
  TAMA_CODEX_TEXT=''
  case "${2:-any}" in
    top) codex_locate_top_level_string "$1" || return 1 ;;
    tool-input) codex_locate_structured_string "$1" 2 0 || return 1 ;;
    first-question) codex_locate_structured_string "$1" 3 1 || return 1 ;;
    *) codex_locate_string "$1" || return 1 ;;
  esac

  local rest="$TAMA_CODEX_REST" out='' before_quote before_escape char hex low_hex
  local escapes=0 codepoint low_codepoint
  while :; do
    case "$rest" in
      *'"'*) ;;
      *) return 1 ;;
    esac
    before_quote="${rest%%\"*}"
    case "$rest" in
      *\\*) before_escape="${rest%%\\*}" ;;
      *) before_escape="$before_quote" ;;
    esac
    if [ "${#before_escape}" -ge "${#before_quote}" ]; then
      out="$out$before_quote"
      break
    fi
    out="$out$before_escape"
    rest="${rest#*\\}"
    char="${rest:0:1}"
    rest="${rest#?}"
    case "$char" in
      n) out="$out"$'\n' ;;
      t) out="$out"$'\t' ;;
      r | b | f) ;;
      u)
        hex="${rest:0:4}"
        [ "${#hex}" -eq 4 ] || return 1
        case "$hex" in *[!0-9A-Fa-f]*) return 1 ;; esac
        rest="${rest:4}"
        codepoint=$((16#$hex))
        if [ "$codepoint" -ge 55296 ] && [ "$codepoint" -le 56319 ]; then
          case "$rest" in \\u????*) ;; *) return 1 ;; esac
          low_hex="${rest:2:4}"
          case "$low_hex" in *[!0-9A-Fa-f]*) return 1 ;; esac
          low_codepoint=$((16#$low_hex))
          [ "$low_codepoint" -ge 56320 ] && [ "$low_codepoint" -le 57343 ] || return 1
          rest="${rest:6}"
          codepoint=$((65536 + (codepoint - 55296) * 1024 + low_codepoint - 56320))
        elif [ "$codepoint" -ge 56320 ] && [ "$codepoint" -le 57343 ]; then
          return 1
        fi
        codex_utf8_char "$codepoint" || return 1
        out="$out$TAMA_CODEX_CHAR"
        ;;
      '"' | \\ | /) out="$out$char" ;;
      *) return 1 ;;
    esac
    escapes=$((escapes + 1))
    [ "$escapes" -lt "$TAMA_CODEX_ESCAPES_MAX" ] || break
    [ "${#out}" -lt "$TAMA_CODEX_TEXT_MAX" ] || break
  done

  if [ "${#out}" -gt "$TAMA_CODEX_TEXT_MAX" ]; then
    out="${out:0:$TAMA_CODEX_TEXT_MAX}"
    case "$out" in *' '*) out="${out% *}" ;; esac
  fi
  case "$out" in
    '' | *[![:space:]]*) ;;
    *) return 1 ;;
  esac
  [ -n "$out" ] || return 1
  TAMA_CODEX_TEXT="$out"
}

codex_state() {
  "$TAMA_BIN" state "$1" "$TAMA_CODEX_AGENT" >/dev/null 2>&1 || true
}

codex_state_and_notify() { # <state> <message>
  codex_state "$1"
  "$TAMA_BIN" notify -- "$TAMA_CODEX_AGENT" "$2" >/dev/null 2>&1 || true
}

codex_auto_review_is_configured() {
  local codex_dir="${CODEX_HOME:-$HOME/.codex}"
  local path="$codex_dir/config.toml" config line found=0 auto='no'
  [ -r "$path" ] || return 1

  config="$(dd if="$path" bs=65537 count=1 2>/dev/null && printf x)" || return 1
  config="${config%x}"
  [ "${#config}" -le 65536 ] || return 1

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    while :; do
      case "$line" in [[:space:]]*) line="${line#?}" ;; *) break ;; esac
    done
    case "$line" in
      '') continue ;;
      '['*) break ;;
      approvals_reviewer*)
        found=$((found + 1))
        local key value
        case "$line" in *'='*) ;; *) auto='no'; continue ;; esac
        key="${line%%=*}"
        value="${line#*=}"
        while :; do
          case "$key" in *[[:space:]]) key="${key%?}" ;; *) break ;; esac
        done
        while :; do
          case "$value" in [[:space:]]*) value="${value#?}" ;; *) break ;; esac
        done
        while :; do
          case "$value" in *[[:space:]]) value="${value%?}" ;; *) break ;; esac
        done
        case "$key:$value" in
          'approvals_reviewer:"auto_review"' | "approvals_reviewer:'auto_review'")
            auto='yes'
            ;;
          *) auto='no' ;;
        esac
        ;;
    esac
  done <<<"$config"

  [ "$found" -eq 1 ] && [ "$auto" = 'yes' ]
}

TAMA_CODEX_EVENT="${1:-}"
case "$TAMA_CODEX_EVENT" in
  SubagentStart | SubagentStop) ;;
  *)
    if codex_text_field agent_id top; then
      exit 0
    fi
    ;;
esac

case "$TAMA_CODEX_EVENT" in
  SessionStart)
    if codex_token_field source; then
      case "$TAMA_CODEX_FIELD" in
        startup | resume | clear) codex_state idle ;;
        compact) : ;;
      esac
    fi
    ;;
  UserPromptSubmit | PostToolUse)
    codex_state running
    ;;
  PreToolUse)
    if codex_token_field tool_name && [ "$TAMA_CODEX_FIELD" = 'request_user_input' ]; then
      codex_text_field question first-question || TAMA_CODEX_TEXT='Codex has a question'
      codex_state_and_notify waiting "$TAMA_CODEX_TEXT"
    fi
    ;;
  PermissionRequest)
    if codex_auto_review_is_configured; then
      codex_state running
    else
      codex_text_field description tool-input || TAMA_CODEX_TEXT='Codex needs your approval'
      codex_state_and_notify waiting "$TAMA_CODEX_TEXT"
    fi
    ;;
  SubagentStart | SubagentStop)
    if codex_text_field agent_id top; then
      case "$TAMA_CODEX_EVENT" in
        SubagentStart)
          "$TAMA_BIN" state subagent-start "$TAMA_CODEX_TEXT" >/dev/null 2>&1 || true
          ;;
        *)
          "$TAMA_BIN" state subagent-stop "$TAMA_CODEX_TEXT" >/dev/null 2>&1 || true
          ;;
      esac
    fi
    ;;
  Stop)
    codex_text_field last_assistant_message top || TAMA_CODEX_TEXT='Codex finished its turn'
    codex_state_and_notify idle "$TAMA_CODEX_TEXT"
    ;;
  SessionEnd)
    codex_state clear
    ;;
  PreCompact | PostCompact | *)
    :
    ;;
esac

exit 0

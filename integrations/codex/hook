#!/usr/bin/env bash
# Codex lifecycle adapter. Codex-specific policy stays outside the stable core.

set -o nounset

[ -n "${TAMA_BIN:-}" ] || exit 0

TAMA_CODEX_AGENT='codex'
TAMA_CODEX_PAYLOAD=''
TAMA_CODEX_PAYLOAD_READ='no'
TAMA_CODEX_FIELD=''
TAMA_CODEX_TEXT=''
TAMA_CODEX_REST=''
TAMA_CODEX_SCOPE=''
TAMA_CODEX_PAYLOAD_TRUNCATED='no'
TAMA_CODEX_PAYLOAD_MAX=65536
TAMA_CODEX_PAYLOAD_TIMEOUT=2
TAMA_CODEX_TEXT_MAX=500
TAMA_CODEX_ESCAPES_MAX=256

codex_read_payload() {
  [ "$TAMA_CODEX_PAYLOAD_READ" = 'no' ] || return 0
  TAMA_CODEX_PAYLOAD_READ='yes'
  [ -t 0 ] && return 0
  IFS= read -r -d '' -n "$((TAMA_CODEX_PAYLOAD_MAX + 1))" \
    -t "$TAMA_CODEX_PAYLOAD_TIMEOUT" TAMA_CODEX_PAYLOAD || true
  if [ "${#TAMA_CODEX_PAYLOAD}" -gt "$TAMA_CODEX_PAYLOAD_MAX" ]; then
    TAMA_CODEX_PAYLOAD="${TAMA_CODEX_PAYLOAD:0:$TAMA_CODEX_PAYLOAD_MAX}"
    TAMA_CODEX_PAYLOAD_TRUNCATED='yes'
  fi
}

codex_locate_structured_value() { # <field> <object-depth> <array-depth> <type> [scope]
  TAMA_CODEX_REST=''
  TAMA_CODEX_SCOPE=''
  codex_read_payload

  # A scope starts immediately after its opening bracket. Its relative depths
  # therefore begin at zero, and a negative depth closes the scope before any
  # sibling fields can be considered.
  local input scoped=0 start
  if [ "$#" -ge 5 ]; then input="$5"; scoped=1; else input="$TAMA_CODEX_PAYLOAD"; fi
  case "$input" in *"\"$1\""*) ;; *) return 1 ;; esac
  start="$(awk -v field="$1" -v wanted_object="$2" -v wanted_array="$3" \
    -v wanted_type="$4" -v scoped="$scoped" '
    {
      input = input $0 "\n"
    }
    END {
      length_input = length(input)
      for (i = 1; i <= length_input; i++) {
        char = substr(input, i, 1)
        if (char == "{") object_depth++
        else if (char == "}") object_depth--
        else if (char == "[") array_depth++
        else if (char == "]") array_depth--
        else if (char == "\"") {
          raw = ""
          escaped = 0
          for (i++; i <= length_input; i++) {
            char = substr(input, i, 1)
            if (escaped) { raw = raw "\\" char; escaped = 0 }
            else if (char == "\\") escaped = 1
            else if (char == "\"") break
            else if (length(raw) <= length(field)) raw = raw char
          }
          if (i > length_input) exit 1
          if (object_depth == wanted_object && array_depth == wanted_array && raw == field) {
            probe = i + 1
            while (substr(input, probe, 1) ~ /[[:space:]]/) probe++
            if (substr(input, probe, 1) != ":") continue
            for (probe++; substr(input, probe, 1) ~ /[[:space:]]/; probe++);
            opener = substr(input, probe, 1)
            if ((wanted_type == "string" && opener == "\"") ||
                (wanted_type == "object" && opener == "{") ||
                (wanted_type == "array" && opener == "[")) {
              print probe
              exit 0
            }
            exit 1
          }
        }
        if (scoped && (object_depth < 0 || array_depth < 0)) exit 1
      }
      exit 1
    }
  ' <<<"$input")" || return 1
  [ -n "$start" ] || return 1
  case "$4" in
    string) TAMA_CODEX_REST="${input:start}" ;;
    object | array) TAMA_CODEX_SCOPE="${input:start}" ;;
  esac
}

codex_locate_top_level_string() { # <field>
  codex_locate_structured_value "$1" 1 0 string
}

codex_locate_tool_input_string() { # <field>
  local scope
  codex_locate_structured_value tool_input 1 0 object || return 1
  scope="$TAMA_CODEX_SCOPE"
  codex_locate_structured_value "$1" 0 0 string "$scope"
}

codex_locate_first_question() {
  local tool_scope questions_scope
  codex_locate_structured_value tool_input 1 0 object || return 1
  tool_scope="$TAMA_CODEX_SCOPE"
  codex_locate_structured_value questions 0 0 array "$tool_scope" || return 1
  questions_scope="$TAMA_CODEX_SCOPE"
  codex_locate_structured_value question 1 0 string "$questions_scope"
}

codex_token_field() { # <field>
  TAMA_CODEX_FIELD=''
  codex_locate_top_level_string "$1" || return 1
  TAMA_CODEX_FIELD="${TAMA_CODEX_REST%%\"*}"
  case "$TAMA_CODEX_FIELD" in
    '' | -* | *[!A-Za-z0-9_-]*) TAMA_CODEX_FIELD=''; return 1 ;;
  esac
}

TAMA_CODEX_CHAR=''

codex_utf8_char() { # <codepoint>
  local codepoint="$1" encoded
  TAMA_CODEX_CHAR=''
  # Bash 3.2 has no Unicode escape formatter. Build the UTF-8 bytes as octal so
  # valid JSON text remains useful without adding a JSON utility dependency.
  [ "$codepoint" -gt 0 ] || return 1
  if [ "$codepoint" -le 127 ]; then
    printf -v encoded '\\%03o' "$codepoint"
  elif [ "$codepoint" -le 2047 ]; then
    printf -v encoded '\\%03o\\%03o' \
      $((192 | codepoint >> 6)) $((128 | codepoint & 63))
  elif [ "$codepoint" -le 65535 ]; then
    printf -v encoded '\\%03o\\%03o\\%03o' \
      $((224 | codepoint >> 12)) $((128 | codepoint >> 6 & 63)) \
      $((128 | codepoint & 63))
  elif [ "$codepoint" -le 1114111 ]; then
    printf -v encoded '\\%03o\\%03o\\%03o\\%03o' \
      $((240 | codepoint >> 18)) $((128 | codepoint >> 12 & 63)) \
      $((128 | codepoint >> 6 & 63)) $((128 | codepoint & 63))
  else
    return 1
  fi
  printf -v TAMA_CODEX_CHAR '%b' "$encoded"
}

codex_text_field() { # <field> [location]
  TAMA_CODEX_TEXT=''
  case "${2:-}" in
    top) codex_locate_top_level_string "$1" || return 1 ;;
    tool-input) codex_locate_tool_input_string "$1" || return 1 ;;
    first-question) codex_locate_first_question || return 1 ;;
    *) return 1 ;;
  esac

  local rest="$TAMA_CODEX_REST" out='' before_quote before_escape char hex low_hex
  local escapes=0 codepoint low_codepoint
  while :; do
    case "$rest" in
      *'"'*) ;;
      *) return 1 ;;
    esac
    before_quote="${rest%%\"*}"
    case "$rest" in
      *\\*) before_escape="${rest%%\\*}" ;;
      *) before_escape="$before_quote" ;;
    esac
    if [ "${#before_escape}" -ge "${#before_quote}" ]; then
      out="$out$before_quote"
      break
    fi
    out="$out$before_escape"
    rest="${rest#*\\}"
    char="${rest:0:1}"
    rest="${rest#?}"
    case "$char" in
      n) out="$out"$'\n' ;;
      t) out="$out"$'\t' ;;
      r) out="$out"$'\n' ;;
      b | f) out="$out " ;;
      u)
        hex="${rest:0:4}"
        [ "${#hex}" -eq 4 ] || return 1
        case "$hex" in *[!0-9A-Fa-f]*) return 1 ;; esac
        rest="${rest:4}"
        codepoint=$((16#$hex))
        if [ "$codepoint" -ge 55296 ] && [ "$codepoint" -le 56319 ]; then
          case "$rest" in \\u????*) ;; *) return 1 ;; esac
          low_hex="${rest:2:4}"
          case "$low_hex" in *[!0-9A-Fa-f]*) return 1 ;; esac
          low_codepoint=$((16#$low_hex))
          [ "$low_codepoint" -ge 56320 ] && [ "$low_codepoint" -le 57343 ] || return 1
          rest="${rest:6}"
          codepoint=$((65536 + (codepoint - 55296) * 1024 + low_codepoint - 56320))
        elif [ "$codepoint" -ge 56320 ] && [ "$codepoint" -le 57343 ]; then
          return 1
        fi
        codex_utf8_char "$codepoint" || return 1
        out="$out$TAMA_CODEX_CHAR"
        ;;
      '"' | \\ | /) out="$out$char" ;;
      *) return 1 ;;
    esac
    escapes=$((escapes + 1))
    [ "$escapes" -lt "$TAMA_CODEX_ESCAPES_MAX" ] || return 1
    [ "${#out}" -lt "$TAMA_CODEX_TEXT_MAX" ] || return 1
  done

  if [ "${#out}" -gt "$TAMA_CODEX_TEXT_MAX" ]; then
    out="${out:0:$TAMA_CODEX_TEXT_MAX}"
    case "$out" in *' '*) out="${out% *}" ;; esac
  fi
  case "$out" in
    '' | *[![:space:]]*) ;;
    *) return 1 ;;
  esac
  [ -n "$out" ] || return 1
  TAMA_CODEX_TEXT="$out"
}

codex_state() {
  "$TAMA_BIN" state "$1" "$TAMA_CODEX_AGENT" >/dev/null 2>&1 || true
}

codex_state_and_notify() { # <state> <message>
  codex_state "$1"
  "$TAMA_BIN" notify -- "$TAMA_CODEX_AGENT" "$2" >/dev/null 2>&1 || true
}

# A Codex process can outlive an individual conversation.  SessionEnd is scoped
# to that conversation, while a tama record is scoped to the pane, so clearing
# the record would hide a still-open Codex TUI.  Clear stale subagent bookkeeping
# first, then leave the pane idle; if Codex itself exits, the normal stale sweep
# removes this fresh record when the pane returns to its shell.
codex_session_end() {
  codex_state clear
  codex_state idle
}

codex_auto_review_is_configured() {
  local codex_dir="${CODEX_HOME:-$HOME/.codex}"
  local path="$codex_dir/config.toml" config
  [ -r "$path" ] || return 1

  config="$(dd if="$path" bs=65537 count=1 2>/dev/null && printf x)" || return 1
  config="${config%x}"
  [ "${#config}" -le 65536 ] || return 1

  awk '
    {
      sub(/#.*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      if ($0 == "") next
      if (substr($0, 1, 1) == "[") exit
      if ($0 ~ /^approvals_reviewer/) {
        found++
        separator = index($0, "=")
        if (!separator) { auto = 0; next }
        key = substr($0, 1, separator - 1)
        value = substr($0, separator + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        auto = key == "approvals_reviewer" &&
          (value == "\"auto_review\"" || value == "\047auto_review\047")
      }
    }
    END { exit !(found == 1 && auto) }
  ' <<<"$config"
}

TAMA_CODEX_EVENT="${1:-}"
codex_read_payload
if [ "$TAMA_CODEX_PAYLOAD_TRUNCATED" = 'yes' ]; then
  [ "$TAMA_CODEX_EVENT" = 'SessionEnd' ] && codex_session_end
  [ "$TAMA_CODEX_EVENT" = 'SubagentStop' ] && printf '{}'
  exit 0
fi
case "$TAMA_CODEX_EVENT" in
  SubagentStart | SubagentStop) ;;
  *)
    # Only the common top-level agent_id signals delegation. Nested tool input
    # may legitimately use the same field name without belonging to a subagent.
    if codex_text_field agent_id top; then
      exit 0
    fi
    ;;
esac

case "$TAMA_CODEX_EVENT" in
  SessionStart)
    if codex_token_field source; then
      case "$TAMA_CODEX_FIELD" in
        startup | resume | clear) codex_state idle ;;
        compact) : ;;
      esac
    fi
    ;;
  UserPromptSubmit | PostToolUse)
    codex_state running
    ;;
  PreToolUse)
    if codex_token_field tool_name && [ "$TAMA_CODEX_FIELD" = 'request_user_input' ]; then
      codex_text_field question first-question || TAMA_CODEX_TEXT='Codex has a question'
      codex_state_and_notify waiting "$TAMA_CODEX_TEXT"
    fi
    ;;
  PermissionRequest)
    if codex_auto_review_is_configured; then
      codex_state running
    else
      if ! codex_text_field description tool-input; then
        TAMA_CODEX_TEXT='Codex needs your approval'
      fi
      codex_state_and_notify waiting "$TAMA_CODEX_TEXT"
    fi
    ;;
  SubagentStart)
    if codex_text_field agent_id top; then
      "$TAMA_BIN" state subagent-start "$TAMA_CODEX_TEXT" >/dev/null 2>&1 || true
    fi
    ;;
  SubagentStop)
    if codex_text_field agent_id top; then
      "$TAMA_BIN" state subagent-stop "$TAMA_CODEX_TEXT" >/dev/null 2>&1 || true
    fi
    # Codex requires a JSON response from every successful SubagentStop hook.
    printf '{}'
    ;;
  Stop)
    if ! codex_text_field last_assistant_message top; then
      TAMA_CODEX_TEXT='Codex finished its turn'
    fi
    codex_state_and_notify idle "$TAMA_CODEX_TEXT"
    ;;
  SessionEnd)
    codex_session_end
    ;;
  PreCompact | PostCompact | *)
    :
    ;;
esac

exit 0

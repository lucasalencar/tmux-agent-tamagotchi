#!/usr/bin/env bash
#
# A tmux that reports whatever version the test asks for and records every call.
# Everything except `-V` is forwarded to the test's real server, so the script
# under test still observes real tmux behaviour.
#
#   TAMA_FAKE_TMUX_VERSION       what `tmux -V` prints (default: the real version)
#   TAMA_FAKE_TMUX_FAIL_VERSION  set to make `tmux -V` fail instead
#   TAMA_FAKE_TMUX_LOG           file the calls are appended to
#   TAMA_FAKE_TMUX_SOCKET        socket name of the test server

set -o nounset

# One argument per line, so a test can assert on which tmux commands ran —
# `grep -x set` finds a set-option and nothing that merely mentions one, and a
# command batched behind a `;` is as visible as the first.
if [ -n "${TAMA_FAKE_TMUX_LOG:-}" ] && [ "$#" -gt 0 ]; then
  printf '%s\n' "$@" >>"$TAMA_FAKE_TMUX_LOG"
fi

if [ "${1:-}" = '-V' ]; then
  [ -z "${TAMA_FAKE_TMUX_FAIL_VERSION:-}" ] || exit 1
  printf '%s\n' "${TAMA_FAKE_TMUX_VERSION:-$(tmux -V)}"
  exit 0
fi

exec tmux -L "$TAMA_FAKE_TMUX_SOCKET" "$@"

#!/usr/bin/env bash
#
# A tmux that reports whatever version the test asks for and records every call.
# Everything except `-V` is forwarded to the test's real server, so the script
# under test still observes real tmux behaviour.
#
#   TAMA_FAKE_TMUX_VERSION       what `tmux -V` prints (default: the real version)
#   TAMA_FAKE_TMUX_FAIL_VERSION  set to make `tmux -V` fail instead
#   TAMA_FAKE_TMUX_FAIL_ALL      set to make every call fail, as an unreachable
#                                server does — a tmux that went away between the
#                                agent's hook firing and this running
#   TAMA_FAKE_TMUX_LOG           file the calls are appended to
#   TAMA_FAKE_TMUX_SOCKET        socket name of the test server
#   TAMA_FAKE_TMUX_COUNTER       file counting this caller's calls, for the two below
#   TAMA_FAKE_TMUX_WAIT_BEFORE   which of that caller's calls waits for the file …
#   TAMA_FAKE_TMUX_WAIT_FOR      … named here to exist
#   TAMA_FAKE_TMUX_TOUCH_AFTER   which of that caller's calls creates the file …
#   TAMA_FAKE_TMUX_TOUCH         … named here, once it has run
#
# Those exist so that a test can *drive* a race between two CLI processes instead
# of starting them at once and hoping. Holding one call until the other side has
# reached a known point puts the two in a known order however slow the machine is,
# which a sleep cannot promise.

set -o nounset

# One argument per line, so a test can assert on which tmux commands ran —
# `grep -x set` finds a set-option and nothing that merely mentions one, and a
# command batched behind a `;` is as visible as the first.
if [ -n "${TAMA_FAKE_TMUX_LOG:-}" ] && [ "$#" -gt 0 ]; then
  printf '%s\n' "$@" >>"$TAMA_FAKE_TMUX_LOG"
fi

tama_call_number=0
if [ -n "${TAMA_FAKE_TMUX_COUNTER:-}" ]; then
  # One line per call, so the count survives across these short-lived processes.
  printf 'x\n' >>"$TAMA_FAKE_TMUX_COUNTER"
  tama_call_number="$(wc -l <"$TAMA_FAKE_TMUX_COUNTER")"
fi

if [ "$tama_call_number" -eq "${TAMA_FAKE_TMUX_WAIT_BEFORE:-0}" ] &&
  [ -n "${TAMA_FAKE_TMUX_WAIT_FOR:-}" ]; then
  # Bounded, so a test that gets the ordering wrong fails instead of hanging.
  tama_waited=0
  while [ ! -e "$TAMA_FAKE_TMUX_WAIT_FOR" ] && [ "$tama_waited" -lt 100 ]; do
    sleep 0.1
    tama_waited=$((tama_waited + 1))
  done
fi

if [ -n "${TAMA_FAKE_TMUX_FAIL_ALL:-}" ]; then
  exit 1
fi

if [ "${1:-}" = '-V' ]; then
  [ -z "${TAMA_FAKE_TMUX_FAIL_VERSION:-}" ] || exit 1
  printf '%s\n' "${TAMA_FAKE_TMUX_VERSION:-$(tmux -V)}"
  exit 0
fi

if [ "$tama_call_number" -eq "${TAMA_FAKE_TMUX_TOUCH_AFTER:-0}" ] &&
  [ -n "${TAMA_FAKE_TMUX_TOUCH:-}" ]; then
  tmux -L "$TAMA_FAKE_TMUX_SOCKET" "$@"
  tama_status=$?
  : >"$TAMA_FAKE_TMUX_TOUCH"
  exit "$tama_status"
fi

exec tmux -L "$TAMA_FAKE_TMUX_SOCKET" "$@"
